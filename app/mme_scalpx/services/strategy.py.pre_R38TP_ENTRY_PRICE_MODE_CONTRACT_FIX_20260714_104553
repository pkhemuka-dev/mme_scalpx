def _r38tmb1_prepare_exit_payload(
    *,
    evaluation,
    position,
    quote,
    now_ns,
):
    if (
        evaluation.decision
        is None
    ):
        raise StrategyBridgeError(
            "R38TMB1 exit evaluation missing decision"
        )

    payload = (
        evaluation.decision.to_dict()
    )

    metadata = _r38tmb1_mapping(
        payload.get(
            "metadata"
        )
    )

    family, branch, symbol, token = (
        _r38tmb1_position_identity(
            position
        )
    )

    bid = _r38tmb1_text(
        quote.get("bid")
    )
    ask = _r38tmb1_text(
        quote.get("ask")
    )

    metadata.update(
        {
            "option_symbol": symbol,
            "option_token": token,
            "instrument_token": token,
            "limit_price": bid,
            "exit_quote_bid": bid,
            "exit_quote_ask": ask,
            "exit_quote_age_ms":
                quote.get(
                    "normalized_age_ms"
                ),
            "exit_quote_owner_path":
                quote.get(
                    "quote_owner_path"
                ),
            "exit_quote_timestamp_domain":
                quote.get(
                    "timestamp_domain"
                ),
            "exit_policy_version":
                "R38TK2_FAMILY_CONTRACT_EXIT_V2_CLOSE",
            "r38tmb1_strategy_owned_exit": 1,
            "paper_exit_manager": True,
            "no_real_live": True,
            "no_broker_order": True,
        }
    )

    payload.update(
        {
            "ts_ns": (
                payload.get(
                    "ts_ns"
                )
                or payload.get(
                    "ts_event_ns"
                )
                or now_ns
            ),
            "ts_event_ns": (
                payload.get(
                    "ts_event_ns"
                )
                or now_ns
            ),
            "action": "EXIT",
            "position_effect": "CLOSE",
            "side": branch,
            "branch_id": branch,
            "strategy_family_id": family,
            "doctrine_id": family,
            # Active manager semantics:
            # instrument_key is token-valued.
            "instrument_key": token,
            "instrument_token": token,
            "option_token": token,
            "option_symbol": symbol,
            "symbol": symbol,
            "qty": 1,
            "quantity_lots": 1,
            "lots": 1,
            "price": bid,
            "limit_price": bid,
            "order_type": "LIMIT",
            "reason":
                evaluation.reason_code,
            "hold_only": 0,
            "activation_report_only": 0,
            "activation_action": "EXIT",
            "activation_promoted": 1,
            "activation_safe_to_promote": 1,
            "r38nn_projection_applied": 0,
            "r38nl_projection_applied": 0,
            "r38ee_projection_projected": 0,
            "r33e_scoped_frame_applied": 0,
            "paper": 1,
            "paper_only": 1,
            "controlled_paper": 1,
            "live_orders_allowed": 0,
            "broker_live_order_allowed": 0,
            "real_live_allowed": 0,
            "real_order_sent_shadow": 0,
            "broker_calls_executed_shadow": 0,
            "redis_trading_stream_write_attempted_shadow": 0,
            "paper_exit_manager": 1,
            "r38tmb1_strategy_owned_exit": 1,
            "r38tmb1_exit_gate_version":
                "R38TMB1_ACTIVE_STRATEGY_EXIT_GATE_V1",
            "exit_policy_version":
                "R38TK2_FAMILY_CONTRACT_EXIT_V2_CLOSE",
            "metadata": metadata,
        }
    )

    return payload


_R38TMB1_ORIGINAL_HOLD_VALIDATOR = (
    _validate_hold_decision_for_publish
)

_R38TMB1_ORIGINAL_STREAM_VALIDATOR = (
    _validate_decision_stream_fields
)


def _r38tmb1_hold_validator(
    decision,
):
    if _r38tmb1_exit_decision_allowed(
        decision
    ):
        return

    return (
        _R38TMB1_ORIGINAL_HOLD_VALIDATOR(
            decision
        )
    )


def _r38tmb1_stream_validator(
    *,
    decision,
    fields,
):
    if _r38tmb1_exit_decision_allowed(
        decision
    ):
        payload = _r38tmb1_mapping(
            fields.get(
                "payload_json"
            )
        )

        if not _r38tmb1_exit_decision_allowed(
            payload
        ):
            raise StrategyBridgeError(
                "R38TMB1 canonical payload_json exit contract mismatch"
            )

        if _r38tmb1_upper(
            fields.get(
                "action"
            )
        ) != "EXIT":
            raise StrategyBridgeError(
                "R38TMB1 flat action field is not EXIT"
            )

        return

    return (
        _R38TMB1_ORIGINAL_STREAM_VALIDATOR(
            decision=decision,
            fields=fields,
        )
    )


_validate_hold_decision_for_publish = (
    _r38tmb1_hold_validator
)

_validate_decision_stream_fields = (
    _r38tmb1_stream_validator
)


