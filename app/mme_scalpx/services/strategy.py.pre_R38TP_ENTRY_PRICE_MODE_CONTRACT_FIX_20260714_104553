# BEGIN R38RF_PROJECTED_ENTER_STRIKE_FROM_OPTION_SYMBOL
def _r38rf_infer_strike_from_option_symbol(value):
    import re as _r38rf_re
    s = str(value or "").strip().upper()
    if not s:
        return None
    # R38RH: NIFTY weekly symbols contain expiry digits before strike.
    # Example: NIFTY2671424050PE -> digits 2671424050 -> last 5 = 24050.
    m = _r38rf_re.search(r"(\d+)(?:CE|PE)$", s)
    if not m:
        return None
    digits = m.group(1)
    if len(digits) < 5:
        return None
    try:
        return float(digits[-5:])
    except Exception:
        return None
# END R38RF_PROJECTED_ENTER_STRIKE_FROM_OPTION_SYMBOL

