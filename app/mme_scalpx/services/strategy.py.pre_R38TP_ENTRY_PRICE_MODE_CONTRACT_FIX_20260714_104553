# --- BEGIN R38QB_COMPACT_DECISION_STREAM_FIELDS ---
# R38QB: compact Redis decision stream payloads only.
# This patch does not change strategy computation. It changes only what is XADDed
# to decisions:mme:stream by replacing oversized JSON fields with byte metadata.
_R38QB_COMPACT_VERSION = "R38QB_COMPACT_DECISION_STREAM_FIELDS_V1"
_R38QB_MAX_STREAM_FIELD_BYTES = 8192
_R38QB_LARGE_DECISION_FIELDS = {
    "payload_json",
    "consumer_view_json",
    "family_surfaces_json",
    "family_features_json",
    "family_frames_json",
    "family_scope_candidates_json",
    "activation_report_json",
    "feature_payload_json",
}
_R38QB_IMPORTANT_DECISION_KEYS = {
    "schema_version",
    "decision_id",
    "service",
    "ts_ns",
    "ts_event_ns",
    "features_generated_at_ns",
    "action",
    "order_action",
    "trade_action",
    "side",
    "branch_id",
    "family",
    "family_id",
    "strategy_family_id",
    "price",
    "confidence",
    "qty",
    "quantity",
    "lots",
    "hold_only",
    "reason",
    "blocker",
    "r38ee_projection_blocker",
    "activation_reason",
    "activation_mode",
    "activation_action",
    "activation_observed_action",
    "activation_bridge_enabled",
    "activation_report_only",
    "instrument_token",
    "option_token",
    "option_symbol",
    "trading_symbol",
    "symbol",
    "regime",
}

def _r38qb_value_bytes(value):
    try:
        if isinstance(value, bytes):
            return len(value)
        if isinstance(value, str):
            return len(value.encode("utf-8", "replace"))
        return len(_json_dump(value).encode("utf-8", "replace"))
    except Exception:
        return len(str(value).encode("utf-8", "replace"))

def _r38qb_stream_value(value):
    if value is None:
        return ""
    if isinstance(value, bool):
        return "1" if value else "0"
    if isinstance(value, (dict, list, tuple)):
        return _json_dump(value)
    return value

def _r38qb_compact_payload_object(raw):
    compact = {}
    omitted = {}
    for key, value in raw.items():
        field = str(key)
        value_bytes = _r38qb_value_bytes(value)
        if field in _R38QB_LARGE_DECISION_FIELDS or value_bytes > _R38QB_MAX_STREAM_FIELD_BYTES:
            omitted[field] = value_bytes
            continue
        compact[field] = value
    # Preserve critical scalars even if future logic changes the broad filter.
    for key in _R38QB_IMPORTANT_DECISION_KEYS:
        if key in raw and key not in compact:
            value = raw.get(key)
            if _r38qb_value_bytes(value) <= _R38QB_MAX_STREAM_FIELD_BYTES:
                compact[key] = value
    compact["r38qb_compacted"] = "1"
    compact["r38qb_compact_version"] = _R38QB_COMPACT_VERSION
    compact["r38qb_omitted_field_bytes"] = omitted
    return compact

def _redis_stream_fields(payload):  # type: ignore[no-redef]
    """
    R38QB compact Redis XADD fields for decisions:mme:stream.

    Execution still receives canonical payload_json, but it is now a compact
    execution/control payload rather than the full multi-family consumer view.
    Large diagnostic surfaces are represented by *_r38qb_original_bytes fields.
    """
    raw = dict(payload or {})
    compact_payload = _r38qb_compact_payload_object(raw)

    out = {
        "payload_json": _json_dump(compact_payload),
        "r38qb_compacted": "1",
        "r38qb_compact_version": _R38QB_COMPACT_VERSION,
    }

    for key, value in raw.items():
        field = str(key)
        if field == "payload_json":
            out["payload_json_r38qb_original_bytes"] = str(_r38qb_value_bytes(value))
            continue

        value_bytes = _r38qb_value_bytes(value)
        if field in _R38QB_LARGE_DECISION_FIELDS or value_bytes > _R38QB_MAX_STREAM_FIELD_BYTES:
            out[f"{field}_r38qb_omitted"] = "1"
            out[f"{field}_r38qb_original_bytes"] = str(value_bytes)
            continue

        out[field] = _r38qb_stream_value(value)

    return out
# --- END R38QB_COMPACT_DECISION_STREAM_FIELDS ---


# BEGIN R38QO_NO_BROKER_PAPER_EVENT_EMITTER_PATCH
# Dedicated no-broker controlled-paper event proof emitter.
# This does NOT write orders:mme:stream, risk:mme:stream, execution:mme:stream,
# trades:ledger:stream, or cmd:mme:stream. It only records a paper proof event
# for genuine promoted strategy decisions when controlled-paper no-broker env is armed.
def _r38qo_txt(value):
    return str(value or "").strip()


def _r38qo_upper(value):
    return _r38qo_txt(value).upper()


def _r38qo_truthy(value):
    return _r38qo_upper(value) in {"1", "TRUE", "YES", "Y", "ON", "ALLOW", "ALLOWED"}


def _r38qo_int(value, default=0):
    try:
        return int(float(_r38qo_txt(value)))
    except Exception:
        return default


def _r38qo_env_allowed():
    import os as _r38qo_os

    if _r38qo_truthy(_r38qo_os.environ.get("SCALPX_ENABLE_LIVE")):
        return False, "SCALPX_ENABLE_LIVE"
    if _r38qo_truthy(_r38qo_os.environ.get("MME_ENABLE_LIVE")):
        return False, "MME_ENABLE_LIVE"
    if _r38qo_truthy(_r38qo_os.environ.get("SCALPX_ALLOW_BROKER_ORDERS")):
        return False, "SCALPX_ALLOW_BROKER_ORDERS"
    if _r38qo_truthy(_r38qo_os.environ.get("MME_ALLOW_BROKER_ORDERS")):
        return False, "MME_ALLOW_BROKER_ORDERS"
    if _r38qo_truthy(_r38qo_os.environ.get("SCALPX_ALLOW_REAL_LIVE")):
        return False, "SCALPX_ALLOW_REAL_LIVE"
    if _r38qo_truthy(_r38qo_os.environ.get("SCALPX_REAL_LIVE_ALLOWED")):
        return False, "SCALPX_REAL_LIVE_ALLOWED"

    if not _r38qo_truthy(_r38qo_os.environ.get("SCALPX_ALLOW_CONTROLLED_PAPER_RUNTIME")):
        return False, "SCALPX_ALLOW_CONTROLLED_PAPER_RUNTIME_MISSING"
    if not _r38qo_truthy(_r38qo_os.environ.get("SCALPX_ENABLE_PAPER")):
        return False, "SCALPX_ENABLE_PAPER_MISSING"
    if not _r38qo_truthy(_r38qo_os.environ.get("SCALPX_PAPER_ARMED")):
        return False, "SCALPX_PAPER_ARMED_MISSING"

    ack = _r38qo_upper(_r38qo_os.environ.get("SCALPX_CONTROLLED_PAPER_NO_BROKER_ACK"))
    scope_ack = _r38qo_upper(_r38qo_os.environ.get("SCALPX_CONTROLLED_PAPER_SCOPE_ACK"))
    if ack != "ACK_FOR_CONTROLLED_PROJECTION" and scope_ack != "ACK_FOR_CONTROLLED_PROJECTION":
        return False, "NO_BROKER_ACK_MISSING"

    return True, "allowed"


def _r38qo_pick(mapping, *keys):
    base = dict(mapping or {})
    for key in keys:
        value = base.get(key)
        if _r38qo_txt(value):
            return value
    return ""


def _r38qo_promoted_no_broker_paper_decision(decision):
    base = dict(decision or {})

    env_ok, env_reason = _r38qo_env_allowed()
    if not env_ok:
        return False, env_reason

    action = _r38qo_upper(_r38qo_pick(base, "action", "activation_action", "activation_selected_action"))
    if action not in {"ENTER_CALL", "ENTER_PUT"}:
        return False, "NOT_ENTER_ACTION"

    qty = _r38qo_int(_r38qo_pick(base, "qty", "quantity_lots", "lots"), 0)
    if qty != 1:
        return False, "QTY_NOT_ONE"

    token = _r38qo_txt(_r38qo_pick(base, "instrument_token", "option_token", "instrument_key"))
    symbol = _r38qo_upper(_r38qo_pick(base, "option_symbol", "symbol", "trading_symbol", "tradingsymbol"))
    if ":" in symbol:
        symbol = symbol.split(":", 1)[1]
    if not token or not symbol:
        return False, "TOKEN_OR_SYMBOL_MISSING"

    if not _r38qo_truthy(base.get("activation_promoted")):
        return False, "activation_promoted_missing"
    if not _r38qo_truthy(base.get("activation_safe_to_promote")):
        return False, "activation_safe_to_promote_missing"
    if not _r38qo_truthy(base.get("r38ee_projection_projected")):
        return False, "r38ee_projection_projected_missing"
    if not _r38qo_truthy(base.get("r33e_scoped_frame_applied")):
        return False, "r33e_scoped_frame_applied_missing"

    for blocker_key in (
        "live_orders_allowed",
        "broker_live_order_allowed",
        "real_live_allowed",
        "real_order_sent_shadow",
        "broker_calls_executed_shadow",
        "redis_trading_stream_write_attempted_shadow",
    ):
        if _r38qo_truthy(base.get(blocker_key)):
            return False, f"{blocker_key}_truthy"

    return True, "allowed"


def _r38qo_no_broker_paper_event_payload(decision):
    import os as _r38qo_os
    import time as _r38qo_time

    base = dict(decision or {})
    now_ns = str(_r38qo_time.time_ns())
    action = _r38qo_upper(_r38qo_pick(base, "action", "activation_action", "activation_selected_action"))
    side = _r38qo_upper(_r38qo_pick(base, "side", "branch_id"))
    if side not in {"CALL", "PUT"}:
        side = "CALL" if action == "ENTER_CALL" else "PUT"

    token = _r38qo_txt(_r38qo_pick(base, "instrument_token", "option_token", "instrument_key"))
    symbol = _r38qo_upper(_r38qo_pick(base, "option_symbol", "symbol", "trading_symbol", "tradingsymbol"))
    if ":" in symbol:
        symbol = symbol.split(":", 1)[1]

    family = _r38qo_upper(_r38qo_pick(base, "strategy_family_id", "family_id", "doctrine_id", "family"))
    price = _r38qo_txt(_r38qo_pick(base, "selected_option_ask", "best_ask", "ask", "limit_price", "price"))

    return {
        "schema_version": "1",
        "service": "strategy",
        "event_type": "NO_BROKER_CONTROLLED_PAPER_PROMOTED_DECISION",
        "paper_event_no_broker": "1",
        "paper_event_marker_only": "1",
        "paper_fill_status": "MARKER_ONLY_NO_BROKER",
        "session_id": _r38qo_txt(_r38qo_os.environ.get("SCALPX_CONTROLLED_PAPER_SESSION_ID")) or "unknown",
        "ts_ns": now_ns,
        "source_decision_id": _r38qo_txt(base.get("decision_id")),
        "source_ts_ns": _r38qo_txt(base.get("ts_ns")),
        "action": action,
        "side": side,
        "family": family,
        "strategy_family_id": family,
        "instrument_token": token,
        "option_token": token,
        "option_symbol": symbol,
        "symbol": symbol,
        "qty": "1",
        "quantity_lots": "1",
        "price": price,
        "order_type": _r38qo_txt(base.get("order_type")) or "LIMIT",
        "activation_promoted": "1",
        "activation_safe_to_promote": "1",
        "r38ee_projection_projected": "1",
        "r33e_scoped_frame_applied": "1",
        "r38qa_b1_exact_scope_raw_enter_promotion_patch": _r38qo_txt(base.get("r38qa_b1_exact_scope_raw_enter_promotion_patch")),
        "R38PP_EXACT_SCOPE_CONTROLLED_PAPER_PROMOTION_ACTIVE": _r38qo_txt(base.get("R38PP_EXACT_SCOPE_CONTROLLED_PAPER_PROMOTION_ACTIVE")),
        "no_broker_ack": _r38qo_txt(_r38qo_os.environ.get("SCALPX_CONTROLLED_PAPER_NO_BROKER_ACK")),
        "scope_ack": _r38qo_txt(_r38qo_os.environ.get("SCALPX_CONTROLLED_PAPER_SCOPE_ACK")),
        "broker_calls_executed_shadow": "0",
        "real_order_sent_shadow": "0",
        "redis_trading_stream_write_attempted_shadow": "0",
        "reason": "r38qo_no_broker_controlled_paper_event_emitted_from_promoted_decision",
    }


def _r38qo_maybe_emit_no_broker_paper_event(self, decision):
    import os as _r38qo_os
    import time as _r38qo_time

    ok, reason = _r38qo_promoted_no_broker_paper_decision(decision)
    if not ok:
        return

    redis_client = getattr(self, "redis", None) or getattr(self, "_redis", None)
    if redis_client is None:
        return

    session_id = _r38qo_txt(_r38qo_os.environ.get("SCALPX_CONTROLLED_PAPER_SESSION_ID")) or str(_r38qo_time.time_ns())
    guard_key = f"state:lane_x:r38qo:paper_event_emitted:{session_id}"

    try:
        claimed = redis_client.set(guard_key, str(_r38qo_time.time_ns()), nx=True, ex=86400)
        if not claimed:
            return
    except Exception:
        return

    event = _r38qo_no_broker_paper_event_payload(decision)
    try:
        stream_id = redis_client.xadd(
            "paper:mme:events:stream",
            event,
            maxlen=1000,
            approximate=True,
        )
        try:
            redis_client.hset(
                "state:lane_x:r38qo:last_paper_event",
                mapping={
                    "last_stream_id": _r38qo_txt(stream_id),
                    "last_session_id": event.get("session_id", ""),
                    "last_action": event.get("action", ""),
                    "last_symbol": event.get("option_symbol", ""),
                    "last_token": event.get("instrument_token", ""),
                    "last_reason": event.get("reason", ""),
                    "last_ts_ns": event.get("ts_ns", ""),
                },
            )
        except Exception:
            pass
    except Exception:
        return


_R38QO_ORIGINAL_PUBLISH_DECISION = StrategyService.publish_decision


def _r38qo_publish_decision_wrapper(self, decision):
    result = _R38QO_ORIGINAL_PUBLISH_DECISION(self, decision)
    _r38qo_maybe_emit_no_broker_paper_event(self, decision)
    return result


StrategyService.publish_decision = _r38qo_publish_decision_wrapper
# END R38QO_NO_BROKER_PAPER_EVENT_EMITTER_PATCH


