# ===== R38SO_COMPACT_R38SM_MEMORY_ATTACH_SUMMARY_ONLY_V1 =====
# Lane X soft-memory attach patch.
#
# Purpose:
# - Attach R38SK/R38SKA common multi-window memory context to future
#   strategy decision payloads.
# - Common for MIST/MISB/MISC/MISR/MISO and CALL/PUT.
# - Soft advisory only.
#
# Safety:
# - Does not start runtime.
# - Does not create an extra Redis write.
# - Does not write to orders/risk/execution/trades/ledger streams.
# - Does not call broker.
# - Does not change action, hold_only, activation_safe_to_promote,
#   controlled_paper_promotable, live_orders_allowed, or broker flags.
# - It only enriches the existing strategy decision payload before the
#   existing decisions:mme:stream XADD happens.

from collections.abc import Mapping as _r38sm_Mapping
import json as _r38sm_json
import logging as _r38sm_logging

_R38SM_LOG = _r38sm_logging.getLogger(__name__)


def _r38sm_text(value):
    if isinstance(value, bytes):
        return value.decode("utf-8", "replace")
    if value is None:
        return ""
    return str(value)


def _r38sm_find_field_key(fields, wanted):
    if not isinstance(fields, _r38sm_Mapping):
        return None
    for key in fields.keys():
        if _r38sm_text(key) == wanted:
            return key
    return None


def _r38sm_stream_name(name):
    return _r38sm_text(name)


def _r38sm_load_json(raw):
    try:
        if isinstance(raw, bytes):
            raw = raw.decode("utf-8", "replace")
        data = _r38sm_json.loads(raw)
        return data if isinstance(data, dict) else None
    except Exception:
        return None


def _r38sm_memory_source_from_payload(payload):
    # Best source is consumer_view_json.family_surfaces because R38SL showed
    # strategy family bridge payloads carry family surfaces there.
    cv_raw = payload.get("consumer_view_json")
    if cv_raw:
        cv = _r38sm_load_json(cv_raw)
        if isinstance(cv, dict):
            fs = cv.get("family_surfaces")
            if isinstance(fs, dict):
                return fs
            return cv

    fs = payload.get("family_surfaces")
    if isinstance(fs, dict):
        return fs

    return payload


def _r38sm_enrich_decision_fields(fields):
    if not isinstance(fields, _r38sm_Mapping):
        return fields

    payload_key = _r38sm_find_field_key(fields, "payload_json")
    if payload_key is None:
        return fields

    payload = _r38sm_load_json(fields.get(payload_key))
    if not isinstance(payload, dict):
        return fields

    if payload.get("r38sm_soft_memory_attached"):
        return fields

    # Only strategy decision payloads / family bridge payloads.
    service = _r38sm_text(payload.get("service")).lower()
    reason = _r38sm_text(payload.get("reason"))
    has_consumer_view = bool(payload.get("consumer_view_json"))
    if service and service != "strategy" and not has_consumer_view:
        return fields
    if not has_consumer_view and "family_features_consumer_bridge" not in reason:
        return fields

    try:
        from app.mme_scalpx.services.feature_family.multi_window_memory import (
            R38SK_MARKER as _R38SM_MEMORY_MARKER,
            build_all_family_memory_context as _r38sm_build_memory,
        )
        source = _r38sm_memory_source_from_payload(payload)
        memory = _r38sm_build_memory(source)
    except Exception as exc:
        _R38SM_LOG.warning("R38SM soft memory attach skipped: memory build failed exc=%r", exc)
        return fields

    # R38SO_COMPACT_R38SM_MEMORY_ATTACH_SUMMARY_ONLY_V1
    # Soft advisory only. Do not mutate trading decision fields.
    # Keep payload compact: attach only summary, not full per-family memory tree.
    summary = memory.get("summary", {}) if isinstance(memory, dict) else {}
    compact_summary = {
        "memory_context_version": _R38SM_MEMORY_MARKER,
        "advisory_only": 1,
        "hard_gate": 0,
        "promotion_decision_owner": "external",
        "family_count": summary.get("family_count"),
        "branch_count": summary.get("branch_count"),
        "pass_count": summary.get("pass_count"),
        "warn_count": summary.get("warn_count"),
        "fail_count": summary.get("fail_count"),
        "best_family_id": summary.get("best_family_id"),
        "best_side": summary.get("best_side"),
        "best_context_score": summary.get("best_context_score"),
    }

    # Remove any full memory object if an older invocation added it.
    payload.pop("multi_window_memory_context", None)
    payload["multi_window_memory_summary"] = compact_summary
    payload["r38sm_soft_memory_attached"] = 1
    payload["r38sm_memory_context_version"] = _R38SM_MEMORY_MARKER
    payload["r38sm_memory_advisory_only"] = 1
    payload["r38sm_memory_hard_gate"] = 0
    payload["r38sm_memory_promotion_decision_owner"] = "external"
    payload["r38so_memory_summary_only"] = 1
    payload["r38so_no_full_memory_context"] = 1
    payload["r38sm_no_action_mutation"] = 1
    payload["r38sm_no_route_permission_mutation"] = 1

    out = dict(fields)
    out[payload_key] = _r38sm_json.dumps(payload, separators=(",", ":"), sort_keys=True)

    # Add small searchable top-level fields on the same existing XADD only.
    if isinstance(payload_key, str):
        out["r38sm_soft_memory_attached"] = "1"
        out["r38sm_memory_context_version"] = _R38SM_MEMORY_MARKER
        out["r38sm_memory_advisory_only"] = "1"
        out["r38sm_memory_hard_gate"] = "0"
        out["r38so_memory_summary_only"] = "1"
        out["r38sm_memory_best_family_id"] = _r38sm_text(compact_summary.get("best_family_id"))
        out["r38sm_memory_best_side"] = _r38sm_text(compact_summary.get("best_side"))
        out["r38sm_memory_best_context_score"] = _r38sm_text(compact_summary.get("best_context_score"))
    return out


def _r38sm_install_decision_xadd_wrapper():
    try:
        import redis as _r38sm_redis
    except Exception as exc:
        _R38SM_LOG.warning("R38SM soft memory attach wrapper not installed: redis import failed exc=%r", exc)
        return False

    redis_cls = getattr(_r38sm_redis, "Redis", None)
    if redis_cls is None:
        return False

    if getattr(redis_cls, "_r38sm_soft_memory_decision_xadd_wrapper_installed", False):
        return True

    original = getattr(redis_cls, "xadd", None)
    if original is None:
        return False

    def _r38sm_xadd_with_soft_memory(self, name, fields, *args, **kwargs):
        try:
            if _r38sm_stream_name(name) == "decisions:mme:stream":
                fields = _r38sm_enrich_decision_fields(fields)
        except Exception as exc:
            _R38SM_LOG.warning("R38SM soft memory attach wrapper skipped after exception exc=%r", exc)
        return original(self, name, fields, *args, **kwargs)

    redis_cls.xadd = _r38sm_xadd_with_soft_memory
    redis_cls._r38sm_soft_memory_decision_xadd_wrapper_installed = True
    redis_cls._r38sm_soft_memory_decision_xadd_wrapper_marker = "R38SM_ATTACH_SOFT_ADVISORY_MEMORY_TO_DECISION_XADD_V1"
    return True


_R38SM_INSTALLED = _r38sm_install_decision_xadd_wrapper()

# ===== END R38SM_ATTACH_SOFT_ADVISORY_MEMORY_TO_DECISION_XADD_V1 =====


# ===== R38SP_LEGACY_R38QO_NO_BROKER_EMITTER_OPT_IN_ONLY_V1 =====
# Lane X hygiene:
# The old R38QO strategy-side no-broker paper-event emitter is legacy.
# R38SG is now the controlled-paper order-intent route to orders:mme:stream.
#
# This patch makes the old R38QO emitter opt-in only so it cannot create
# confusing duplicate paper-event evidence during the next controlled-paper proof.
#
# Safety:
# - no start
# - no XADD during patch
# - no order
# - no broker
# - no action/hold/promotion mutation
# - no effect unless legacy env is explicitly enabled

import os as _r38sp_os
import logging as _r38sp_logging

_R38SP_LOG = _r38sp_logging.getLogger(__name__)

if "_r38qo_maybe_emit_no_broker_paper_event" in globals():
    _R38SP_ORIGINAL_R38QO_MAYBE_EMIT = globals()["_r38qo_maybe_emit_no_broker_paper_event"]

    def _r38sp_r38qo_maybe_emit_no_broker_paper_event_opt_in_only(self, decision):
        enabled = str(_r38sp_os.environ.get("SCALPX_ENABLE_R38QO_LEGACY_NO_BROKER_EVENT", "")).strip().lower()
        if enabled not in {"1", "true", "yes", "on"}:
            try:
                _R38SP_LOG.info(
                    "R38SP skipped legacy R38QO no-broker paper-event emitter because SCALPX_ENABLE_R38QO_LEGACY_NO_BROKER_EVENT is not enabled"
                )
            except Exception:
                pass
            return None
        return _R38SP_ORIGINAL_R38QO_MAYBE_EMIT(self, decision)

    globals()["_r38qo_maybe_emit_no_broker_paper_event"] = _r38sp_r38qo_maybe_emit_no_broker_paper_event_opt_in_only
    R38SP_R38QO_LEGACY_EMITTER_OPT_IN_ONLY_INSTALLED = True
else:
    R38SP_R38QO_LEGACY_EMITTER_OPT_IN_ONLY_INSTALLED = False

# ===== END R38SP_LEGACY_R38QO_NO_BROKER_EMITTER_OPT_IN_ONLY_V1 =====



# BEGIN R38TMB1_ACTIVE_STRATEGY_EXIT_GATE_V1
#
# Integrates:
#   R38TMBQ4 exact open-position quote resolver
#   R38TK2 family target/stop/time exit manager
#
# This block does not directly write order/risk/execution streams and does not
# call a broker. It may publish one canonical EXIT decision only through the
# existing StrategyService.publish_decision path when every exact controlled-
# paper gate passes.
#
# While a position is open, new ENTER decisions are suppressed. A successful
# EXIT publication latches the position identity until execution changes the
# position state or the strategy service is restarted.

import json as _r38tmb1_json
import os as _r38tmb1_os
import time as _r38tmb1_time
from collections.abc import Mapping as _r38tmb1_Mapping

from app.mme_scalpx.services.strategy_family.exact_position_quote_resolver import (
    ExactPositionQuoteResolver as _R38TMB1ExactPositionQuoteResolver,
)
from app.mme_scalpx.services.strategy_family.position_exit_manager import (
    PositionExitManager as _R38TMB1PositionExitManager,
)


_R38TMB1_POLICY_ACK = (
    "R38TK2_FAMILY_CONTRACT_EXIT_V2_CLOSE_TARGET5_STOP4_TIME90"
)

_R38TMB1_SCOPE_ACK = (
    "R38TMB1_EXACT_OPEN_POSITION_ONE_LOT_ONE_EVENT_NO_REAL_LIVE_NO_BROKER"
)

_R38TMB1_LOCAL_UTC_OFFSET_NS = 19_800_000_000_000

_R38TMB1_ELIGIBLE_FAMILIES = {
    "MIST",
    "MISB",
    "MISC",
    "MISR",
}

_R38TMB1_DANGEROUS_ENV_KEYS = (
    "SCALPX_ENABLE_LIVE",
    "SCALPX_REAL_LIVE_ALLOWED",
    "SCALPX_ALLOW_REAL_LIVE",
    "SCALPX_ALLOW_BROKER_ORDERS",
    "SCALPX_BROKER_ORDER_ENABLED",
    "MME_ENABLE_LIVE",
    "MME_ALLOW_LIVE_ORDER",
)

_R38TMB1_OBSERVE_ONLY_ENV_KEYS = (
    "SCALPX_OBSERVE_ONLY",
    "B1_PROFIT_CLASSIC_RUNTIME_OBSERVE_ONLY",
)


def _r38tmb1_text(value):
    if value is None:
        return ""

    if isinstance(value, bytes):
        return value.decode(
            "utf-8",
            errors="replace",
        ).strip()

    return str(value).strip()


def _r38tmb1_upper(value):
    return _r38tmb1_text(value).upper()


def _r38tmb1_truthy(value):
    return _r38tmb1_upper(value) in {
        "1",
        "TRUE",
        "YES",
        "ON",
    }


def _r38tmb1_int(value, default=0):
    try:
        if isinstance(value, bool):
            return default

        return int(str(value).strip())
    except (TypeError, ValueError):
        return default


def _r38tmb1_float(value, default=0.0):
    try:
        return float(str(value).strip())
    except (TypeError, ValueError):
        return default


def _r38tmb1_symbol(value):
    result = _r38tmb1_upper(value)

    if ":" in result:
        result = result.split(
            ":",
            1,
        )[1]

    return result


def _r38tmb1_mapping(value):
    if isinstance(
        value,
        _r38tmb1_Mapping,
    ):
        return dict(value)

    if isinstance(
        value,
        (str, bytes),
    ):
        try:
            parsed = _r38tmb1_json.loads(
                _r38tmb1_text(value)
            )
        except Exception:
            return {}

        if isinstance(
            parsed,
            _r38tmb1_Mapping,
        ):
            return dict(parsed)

    return {}


def _r38tmb1_decoded_hash(
    redis_client,
    key,
):
    try:
        raw = redis_client.hgetall(
            key
        ) or {}
    except Exception:
        return {}

    return {
        _r38tmb1_text(field):
            _r38tmb1_text(value)
        for field, value
        in raw.items()
    }


def _r38tmb1_position_identity(
    position,
):
    family = _r38tmb1_upper(
        position.get(
            "strategy_family_id"
        )
        or position.get(
            "family_id"
        )
        or position.get(
            "doctrine_id"
        )
    )

    branch = _r38tmb1_upper(
        position.get("branch_id")
        or position.get("side")
    )

    if branch == "CE":
        branch = "CALL"
    elif branch == "PE":
        branch = "PUT"

    position_side = _r38tmb1_upper(
        position.get(
            "position_side"
        )
    )

    if not branch:
        if position_side in {
            "CALL",
            "LONG_CALL",
        }:
            branch = "CALL"
        elif position_side in {
            "PUT",
            "LONG_PUT",
        }:
            branch = "PUT"

    symbol = _r38tmb1_symbol(
        position.get(
            "entry_option_symbol"
        )
        or position.get(
            "option_symbol"
        )
        or position.get(
            "trading_symbol"
        )
        or position.get(
            "symbol"
        )
    )

    token = _r38tmb1_text(
        position.get(
            "entry_option_token"
        )
        or position.get(
            "option_token"
        )
        or position.get(
            "instrument_token"
        )
    )

    return (
        family,
        branch,
        symbol,
        token,
    )


def _r38tmb1_position_open(
    position,
):
    return bool(
        _r38tmb1_truthy(
            position.get(
                "has_position"
            )
        )
        and _r38tmb1_upper(
            position.get(
                "position_side"
            )
        )
        not in {
            "",
            "FLAT",
        }
        and _r38tmb1_int(
            position.get(
                "qty_lots"
            ),
            0,
        )
        > 0
        and _r38tmb1_int(
            position.get(
                "qty_units"
            ),
            0,
        )
        > 0
    )


def _r38tmb1_static_env_gate(
    *,
    family,
    branch,
    symbol,
    token,
    qty_lots,
):
    env = _r38tmb1_os.environ

    if not _r38tmb1_truthy(
        env.get(
            "SCALPX_ENABLE_STRATEGY_OWNED_EXIT_MANAGER"
        )
    ):
        return (
            False,
            "EXIT_MANAGER_NOT_ENABLED",
        )

    if _r38tmb1_upper(
        env.get(
            "SCALPX_STRATEGY_EXIT_POLICY_ACK"
        )
    ) != _R38TMB1_POLICY_ACK:
        return (
            False,
            "EXIT_POLICY_ACK_MISMATCH",
        )

    if _r38tmb1_upper(
        env.get(
            "SCALPX_STRATEGY_EXIT_SCOPE_ACK"
        )
    ) != _R38TMB1_SCOPE_ACK:
        return (
            False,
            "EXIT_SCOPE_ACK_MISMATCH",
        )

    for key in (
        "SCALPX_ALLOW_CONTROLLED_PAPER_RUNTIME",
        "SCALPX_CONTROLLED_PAPER_ARMED",
        "SCALPX_PAPER_ARMED",
    ):
        if not _r38tmb1_truthy(
            env.get(key)
        ):
            return (
                False,
                key + "_MISSING",
            )

    for key in (
        *_R38TMB1_DANGEROUS_ENV_KEYS,
        *_R38TMB1_OBSERVE_ONLY_ENV_KEYS,
    ):
        if _r38tmb1_truthy(
            env.get(key)
        ):
            return (
                False,
                key + "_MUST_BE_FALSE",
            )

    configured_lots = _r38tmb1_int(
        env.get(
            "SCALPX_CONTROLLED_PAPER_QTY_LOTS"
        )
        or env.get(
            "SCALPX_CONTROLLED_PAPER_MAX_LOTS"
        ),
        0,
    )

    configured_events = _r38tmb1_int(
        env.get(
            "SCALPX_CONTROLLED_PAPER_MAX_EVENTS"
        )
        or env.get(
            "SCALPX_CONTROLLED_PAPER_MAX_EVENT"
        ),
        0,
    )

    if configured_lots != 1:
        return (
            False,
            "CONFIGURED_LOTS_NOT_ONE",
        )

    if configured_events != 1:
        return (
            False,
            "CONFIGURED_EVENTS_NOT_ONE",
        )

    if _r38tmb1_int(
        qty_lots,
        0,
    ) != 1:
        return (
            False,
            "POSITION_LOTS_NOT_ONE",
        )

    if family not in (
        _R38TMB1_ELIGIBLE_FAMILIES
    ):
        return (
            False,
            "FAMILY_NOT_ELIGIBLE",
        )

    if branch not in {
        "CALL",
        "PUT",
    }:
        return (
            False,
            "BRANCH_NOT_CALL_PUT",
        )

    if (
        not symbol
        or not token
    ):
        return (
            False,
            "IDENTITY_MISSING",
        )

    env_family = _r38tmb1_upper(
        env.get(
            "SCALPX_CONTROLLED_PAPER_FAMILY"
        )
    )

    env_branch = _r38tmb1_upper(
        env.get(
            "SCALPX_CONTROLLED_PAPER_SIDE"
        )
        or env.get(
            "SCALPX_CONTROLLED_PAPER_BRANCH"
        )
    )

    if env_branch == "CE":
        env_branch = "CALL"
    elif env_branch == "PE":
        env_branch = "PUT"

    env_symbol = _r38tmb1_symbol(
        env.get(
            "SCALPX_CONTROLLED_PAPER_OPTION_SYMBOL"
        )
    )

    env_token = _r38tmb1_text(
        env.get(
            "SCALPX_CONTROLLED_PAPER_INSTRUMENT_TOKEN"
        )
    )

    if env_family != family:
        return (
            False,
            "FAMILY_SCOPE_MISMATCH",
        )

    if env_branch != branch:
        return (
            False,
            "BRANCH_SCOPE_MISMATCH",
        )

    if env_symbol != symbol:
        return (
            False,
            "SYMBOL_SCOPE_MISMATCH",
        )

    if env_token != token:
        return (
            False,
            "TOKEN_SCOPE_MISMATCH",
        )

    return (
        True,
        "EXACT_CONTROLLED_PAPER_EXIT_GATE_OK",
    )


def _r38tmb1_position_gate(
    position,
):
    if not _r38tmb1_position_open(
        position
    ):
        return (
            False,
            "POSITION_NOT_OPEN",
        )

    if _r38tmb1_truthy(
        position.get(
            "exit_pending"
        )
        or position.get(
            "pending_exit"
        )
    ):
        return (
            False,
            "EXIT_ALREADY_PENDING",
        )

    if _r38tmb1_float(
        position.get(
            "avg_price"
        )
        or position.get(
            "entry_price"
        ),
        0.0,
    ) <= 0:
        return (
            False,
            "ENTRY_PRICE_INVALID",
        )

    if _r38tmb1_int(
        position.get(
            "entry_ts_ns"
        )
        or position.get(
            "opened_ts_ns"
        ),
        0,
    ) <= 0:
        return (
            False,
            "ENTRY_TIMESTAMP_INVALID",
        )

    family, branch, symbol, token = (
        _r38tmb1_position_identity(
            position
        )
    )

    return _r38tmb1_static_env_gate(
        family=family,
        branch=branch,
        symbol=symbol,
        token=token,
        qty_lots=position.get(
            "qty_lots"
        ),
    )


def _r38tmb1_decision_identity(
    decision,
):
    payload = _r38tmb1_mapping(
        decision
    )

    metadata = _r38tmb1_mapping(
        payload.get(
            "metadata"
        )
    )

    family = _r38tmb1_upper(
        payload.get(
            "strategy_family_id"
        )
        or payload.get(
            "family_id"
        )
        or payload.get(
            "doctrine_id"
        )
        or metadata.get(
            "strategy_family_id"
        )
        or metadata.get(
            "family_id"
        )
    )

    branch = _r38tmb1_upper(
        payload.get(
            "branch_id"
        )
        or payload.get(
            "side"
        )
        or metadata.get(
            "branch_id"
        )
        or metadata.get(
            "side"
        )
    )

    symbol = _r38tmb1_symbol(
        payload.get(
            "option_symbol"
        )
        or payload.get(
            "trading_symbol"
        )
        or payload.get(
            "symbol"
        )
        or metadata.get(
            "option_symbol"
        )
        or metadata.get(
            "trading_symbol"
        )
        or metadata.get(
            "symbol"
        )
    )

    # instrument_key is token-valued in the active manager contract.
    token = _r38tmb1_text(
        payload.get(
            "option_token"
        )
        or payload.get(
            "instrument_token"
        )
        or metadata.get(
            "option_token"
        )
        or metadata.get(
            "instrument_token"
        )
        or payload.get(
            "instrument_key"
        )
    )

    qty_lots = _r38tmb1_int(
        payload.get(
            "qty"
        )
        or payload.get(
            "quantity_lots"
        )
        or payload.get(
            "lots"
        ),
        0,
    )

    return (
        payload,
        metadata,
        family,
        branch,
        symbol,
        token,
        qty_lots,
    )


def _r38tmb1_exit_decision_allowed(
    decision,
):
    (
        payload,
        metadata,
        family,
        branch,
        symbol,
        token,
        qty_lots,
    ) = _r38tmb1_decision_identity(
        decision
    )

    if _r38tmb1_upper(
        payload.get(
            "action"
        )
    ) != "EXIT":
        return False

    if _r38tmb1_upper(
        payload.get(
            "position_effect"
        )
    ) != "CLOSE":
        return False

    if not _r38tmb1_truthy(
        payload.get(
            "r38tmb1_strategy_owned_exit"
        )
        or metadata.get(
            "r38tmb1_strategy_owned_exit"
        )
    ):
        return False

    if _r38tmb1_upper(
        payload.get(
            "exit_policy_version"
        )
        or metadata.get(
            "exit_policy_version"
        )
    ) != "R38TK2_FAMILY_CONTRACT_EXIT_V2_CLOSE":
        return False

    if not _r38tmb1_truthy(
        payload.get(
            "controlled_paper"
        )
    ):
        return False

    if not _r38tmb1_truthy(
        payload.get(
            "paper"
        )
    ):
        return False

    if _r38tmb1_truthy(
        payload.get(
            "live_orders_allowed"
        )
        or payload.get(
            "broker_live_order_allowed"
        )
        or payload.get(
            "real_live_allowed"
        )
        or payload.get(
            "broker_calls_executed_shadow"
        )
        or payload.get(
            "real_order_sent_shadow"
        )
    ):
        return False

    gate_ok, _ = (
        _r38tmb1_static_env_gate(
            family=family,
            branch=branch,
            symbol=symbol,
            token=token,
            qty_lots=qty_lots,
        )
    )

    return bool(gate_ok)


def _r38tmb1_read_family_surfaces(
    redis_client,
):
    raw = None

    try:
        raw = redis_client.hget(
            "state:features:mme:fut",
            "family_surfaces_json",
        )
    except Exception:
        raw = None

    if raw is None:
        feature_hash = (
            _r38tmb1_decoded_hash(
                redis_client,
                "state:features:mme:fut",
            )
        )

        raw = feature_hash.get(
            "family_surfaces_json"
        )

    surfaces = _r38tmb1_mapping(
        raw
    )

    if not surfaces:
        raise StrategyBridgeError(
            "R38TMB1 family_surfaces_json missing or invalid"
        )

    return surfaces


def _r38tmb1_position_key(
    position,
):
    family, branch, symbol, token = (
        _r38tmb1_position_identity(
            position
        )
    )

    return "|".join(
        (
            family,
            branch,
            symbol,
            token,
            _r38tmb1_text(
                position.get(
                    "entry_ts_ns"
                )
            ),
            _r38tmb1_text(
                position.get(
                    "decision_id"
                )
                or position.get(
                    "entry_decision_id"
                )
            ),
        )
    )


