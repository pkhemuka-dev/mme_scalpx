# BEGIN R38QB_ALLOW_PROJECTED_CONTROLLED_PAPER_THROUGH_HOLD_VALIDATOR
# Narrow validator exception:
# Only exact-scope projected controlled-paper rows may pass the HOLD-only validator,
# and only when paper runtime is armed, live/broker flags are off, and no-broker ACK matches.
def _r38qb_allow_projected_controlled_paper_through_hold_validator(decision):
    import json as _r38qb_json
    import os as _r38qb_os

    base = dict(decision or {})

    def _txt(v):
        return str(v or "").strip()

    def _upper(v):
        return _txt(v).upper()

    def _truthy(v):
        return _upper(v) in {"1", "TRUE", "YES", "Y", "ON", "ALLOW", "ALLOWED"}

    def _int(v, default=0):
        try:
            return int(float(_txt(v)))
        except Exception:
            return default

    # Fail closed on any live/broker permission.
    if _truthy(_r38qb_os.environ.get("SCALPX_ENABLE_LIVE")) or _truthy(_r38qb_os.environ.get("MME_ENABLE_LIVE")):
        return False
    if _truthy(_r38qb_os.environ.get("SCALPX_ALLOW_BROKER_ORDERS")) or _truthy(_r38qb_os.environ.get("MME_ALLOW_BROKER_ORDERS")):
        return False
    if _truthy(base.get("live_orders_allowed")):
        return False
    if _truthy(base.get("broker_live_order_allowed")):
        return False
    if _truthy(base.get("real_live_allowed")):
        return False
    if _truthy(base.get("real_order_sent_shadow")):
        return False
    if _truthy(base.get("broker_calls_executed_shadow")):
        return False
    if _truthy(base.get("redis_trading_stream_write_attempted_shadow")):
        return False

    # Paper runtime must be explicitly armed.
    if not _truthy(_r38qb_os.environ.get("SCALPX_ALLOW_CONTROLLED_PAPER_RUNTIME")):
        return False
    if not _truthy(_r38qb_os.environ.get("SCALPX_ENABLE_PAPER")):
        return False
    if not _truthy(_r38qb_os.environ.get("SCALPX_PAPER_ARMED")):
        return False

    env_family = _upper(_r38qb_os.environ.get("SCALPX_CONTROLLED_PAPER_FAMILY"))
    env_side = _upper(_r38qb_os.environ.get("SCALPX_CONTROLLED_PAPER_SIDE") or _r38qb_os.environ.get("SCALPX_CONTROLLED_PAPER_BRANCH"))
    env_action = _upper(_r38qb_os.environ.get("SCALPX_CONTROLLED_PAPER_ACTION"))
    env_token = _txt(_r38qb_os.environ.get("SCALPX_CONTROLLED_PAPER_INSTRUMENT_TOKEN"))
    env_symbol = _upper(_r38qb_os.environ.get("SCALPX_CONTROLLED_PAPER_OPTION_SYMBOL"))
    env_ack = _upper(_r38qb_os.environ.get("SCALPX_CONTROLLED_PAPER_SCOPE_ACK"))
    env_no_broker_ack = _upper(_r38qb_os.environ.get("SCALPX_CONTROLLED_PAPER_NO_BROKER_ACK"))

    if ":" in env_symbol:
        env_symbol = env_symbol.split(":", 1)[1]

    # BEGIN R38QH_DYNAMIC_FIRST_ENTER_VALIDATOR_ENV
    dynamic_first_enter = _truthy(_r38qb_os.environ.get("SCALPX_CONTROLLED_PAPER_DYNAMIC_FIRST_ENTER"))
    if dynamic_first_enter:
        env_side = "AUTO"
        env_action = "AUTO_ENTER"
        env_token = "AUTO"
        env_symbol = "AUTO"
    else:
        if not all([env_family, env_side, env_action, env_token, env_symbol, env_ack]):
            return False
        if env_side not in {"CALL", "PUT"} or env_action != "ENTER_" + env_side:
            return False
    if env_ack != "ACK_FOR_CONTROLLED_PROJECTION" and env_ack != env_no_broker_ack:
        return False
    # END R38QH_DYNAMIC_FIRST_ENTER_VALIDATOR_ENV

    payload = {}
    for k, v in list(base.items()):
        if isinstance(v, str) and v.strip().startswith("{"):
            try:
                obj = _r38qb_json.loads(v)
                if isinstance(obj, dict):
                    payload.update(obj)
            except Exception:
                pass

    def _pick(*keys):
        for k in keys:
            if _txt(base.get(k)):
                return _txt(base.get(k))
            if _txt(payload.get(k)):
                return _txt(payload.get(k))
        return ""

    action = _upper(_pick("action", "activation_action", "activation_selected_action"))
    side = _upper(_pick("side", "branch_id", "activation_selected_branch_id"))
    if side == "CE":
        side = "CALL"
    if side == "PE":
        side = "PUT"

    family = _upper(_pick("strategy_family_id", "family_id", "doctrine_id", "family"))
    token = _txt(_pick("instrument_token", "option_token", "instrument_key"))
    symbol = _upper(_pick("option_symbol", "symbol", "trading_symbol"))
    if ":" in symbol:
        symbol = symbol.split(":", 1)[1]
    qty = _int(_pick("qty", "quantity_lots", "lots"), 0)

    # BEGIN R38QH_DYNAMIC_FIRST_ENTER_VALIDATOR_MATCH
    if family != env_family:
        return False
    if dynamic_first_enter:
        if action not in {"ENTER_CALL", "ENTER_PUT"}:
            return False
        if side not in {"CALL", "PUT"}:
            side = "CALL" if action == "ENTER_CALL" else "PUT"
        if action != "ENTER_" + side:
            return False
        if not token or not symbol:
            return False
    else:
        if side != env_side or action != env_action:
            return False
        if token != env_token or symbol != env_symbol:
            return False
    if qty != 1:
        return False
    # END R38QH_DYNAMIC_FIRST_ENTER_VALIDATOR_MATCH

    if not _truthy(base.get("activation_promoted")):
        return False
    if not _truthy(base.get("activation_safe_to_promote")):
        return False
    if not _truthy(base.get("r38ee_projection_projected")):
        return False
    if not _truthy(base.get("r33e_scoped_frame_applied")):
        return False
    if _txt(base.get("r38ee_projection_blocker")) != "projected":
        return False

    return True
# END R38QB_ALLOW_PROJECTED_CONTROLLED_PAPER_THROUGH_HOLD_VALIDATOR

def _validate_hold_decision_for_publish(decision: Mapping[str, Any]) -> None:
    # R38QB: exact-scope projected controlled-paper rows bypass HOLD-only validation.
    if _r38qb_allow_projected_controlled_paper_through_hold_validator(decision):
        return
    """
    Enforce the frozen Batch 10 strategy.py law before Redis publication.

    strategy.py is a HOLD-only consumer bridge in this lane. Even if a future
    activation/report module observes candidates, this service may not publish
    promoted ENTER/EXIT decisions until a later explicit arming contract changes
    this file and its proofs.
    """

    if _r38ee_controlled_paper_bridge_allowed(decision) or _r38tz_live_one_event_bridge_allowed(decision):
        return

    if _r33e_controlled_projected_publish_allowed(decision):
        return

    action = _safe_str(decision.get("action"), ACTION_HOLD)
    if action != ACTION_HOLD:
        raise StrategyBridgeError(
            f"strategy.py HOLD-only bridge refused non-HOLD action: {action!r}"
        )

    qty = _safe_int(decision.get("qty"), 0)
    if qty != 0:
        raise StrategyBridgeError(
            f"strategy.py HOLD-only bridge refused non-zero qty: {qty!r}"
        )

    if not _safe_bool(decision.get("hold_only"), False):
        raise StrategyBridgeError("strategy.py HOLD-only bridge requires hold_only=1")

    if not _safe_bool(decision.get("activation_report_only"), False):
        raise StrategyBridgeError(
            "strategy.py HOLD-only bridge requires activation_report_only=1"
        )

    activation_action = _safe_str(decision.get("activation_action"), ACTION_HOLD)
    if activation_action != ACTION_HOLD:
        raise StrategyBridgeError(
            "strategy.py HOLD-only bridge refused non-HOLD activation_action: "
            f"{activation_action!r}"
        )

    if _safe_bool(decision.get("activation_promoted"), False):
        raise StrategyBridgeError(
            "strategy.py HOLD-only bridge refused activation_promoted truthy"
        )

    if _safe_bool(decision.get("activation_safe_to_promote"), False):
        raise StrategyBridgeError(
            "strategy.py HOLD-only bridge refused activation_safe_to_promote truthy"
        )

    if _safe_bool(decision.get("live_orders_allowed"), False):
        raise StrategyBridgeError(
            "strategy.py HOLD-only bridge refused live_orders_allowed truthy"
        )


def _validate_decision_stream_fields(
    *,
    decision: Mapping[str, Any],
    fields: Mapping[str, Any],
) -> None:
    # R38QC: exact-scope projected controlled-paper rows bypass stream field validation.
    try:
        _r38qc_merged = dict(decision or {})
        _r38qc_merged.update(dict(fields or {}))
        if _r38qb_allow_projected_controlled_paper_through_hold_validator(_r38qc_merged):
            return
    except Exception:
        pass
    """
    Prove flat fields and canonical payload_json cannot drift.

    execution.py consumes payload_json as canonical. The strategy publisher must
    therefore ensure that payload_json.action and payload_json.qty preserve the
    HOLD-only contract and agree with the flat operator-visible fields.
    """

    payload = _mapping(_json_load(fields.get("payload_json"), field_name="payload_json"))

    payload_action = _safe_str(payload.get("action"), "")
    flat_action = _safe_str(fields.get("action"), "")

    if _r38ee_controlled_paper_bridge_allowed(payload) or _r38tz_live_one_event_bridge_allowed(payload):
        if not payload_action:
            raise StrategyBridgeError("payload_json.action missing")
        if flat_action != payload_action:
            raise StrategyBridgeError(
                "strategy.py refused controlled-paper decision stream action mismatch: "
                f"payload_action={payload_action!r}, flat_action={flat_action!r}"
            )
        payload_qty = _safe_int(payload.get("qty"), -1)
        flat_qty = _safe_int(fields.get("qty"), -1)
        if payload_qty != 1 or flat_qty != 1:
            raise StrategyBridgeError(
                "strategy.py refused controlled-paper decision stream qty mismatch: "
                f"payload_qty={payload_qty!r}, flat_qty={flat_qty!r}"
            )
        return

    if payload_action != ACTION_HOLD or flat_action != ACTION_HOLD:
        raise StrategyBridgeError(
            "strategy.py refused decision stream action mismatch: "
            f"payload_action={payload_action!r}, flat_action={flat_action!r}"
        )

    payload_qty = _safe_int(payload.get("qty"), -1)
    flat_qty = _safe_int(fields.get("qty"), -1)
    if payload_qty != 0 or flat_qty != 0:
        raise StrategyBridgeError(
            "strategy.py refused decision stream qty mismatch: "
            f"payload_qty={payload_qty!r}, flat_qty={flat_qty!r}"
        )

    # Re-run the semantic guard on the decoded canonical payload, not only on
    # the original in-memory mapping.
    _validate_hold_decision_for_publish(payload)


def _nested(root: Any, *keys: str, default: Any = None) -> Any:
    current = root
    for key in keys:
        if not isinstance(current, Mapping):
            return default
        current = current.get(key)
        if current is None:
            return default
    return current


def _mapping(value: Any) -> dict[str, Any]:
    if isinstance(value, Mapping):
        return dict(value)
    if hasattr(value, "to_dict"):
        with contextlib.suppress(Exception):
            out = value.to_dict()
            if isinstance(out, Mapping):
                return dict(out)
    if hasattr(value, "__dict__"):
        return dict(vars(value))
    return {}


def _now_ns_from_clock(clock: Any) -> int:
    for attr in ("now_ns", "time_ns"):
        fn = getattr(clock, attr, None)
        if callable(fn):
            with contextlib.suppress(Exception):
                return int(fn())
    return time.time_ns()


