    if _r38ee_env_truthy("SCALPX_ENABLE_PAPER") or _r38ee_env_truthy("MME_ENABLE_PAPER") or _r38ee_env_truthy("SCALPX_PAPER_ARMED") or _r38ee_env_truthy("SCALPX_ALLOW_CONTROLLED_PAPER_RUNTIME"):
