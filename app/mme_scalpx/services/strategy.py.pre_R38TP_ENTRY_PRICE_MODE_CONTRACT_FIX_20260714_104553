    "_r38tmb1_exit_integration_installed",
    False,
):
    _R38TMB1_ORIGINAL_INIT = (
        StrategyService.__init__
    )

    _R38TMB1_ORIGINAL_RUN_ONCE = (
        StrategyService.run_once
    )

    def _r38tmb1_init(
        self,
        *args,
        **kwargs,
    ):
        _R38TMB1_ORIGINAL_INIT(
            self,
            *args,
            **kwargs,
        )

        self._r38tmb1_exit_manager = (
            _R38TMB1PositionExitManager()
        )

        self._r38tmb1_quote_resolver = (
            _R38TMB1ExactPositionQuoteResolver()
        )

        self._r38tmb1_exit_latched_position_key = ""

    def _r38tmb1_run_once(
        self,
    ):
        now_ns = self._now_ns()

        position = _r38tmb1_decoded_hash(
            self.redis,
            "state:position:mme",
        )

        if not _r38tmb1_position_open(
            position
        ):
            self._r38tmb1_exit_latched_position_key = ""

            return _R38TMB1_ORIGINAL_RUN_ONCE(
                self
            )

        position_key = (
            _r38tmb1_position_key(
                position
            )
        )

        if (
            self._r38tmb1_exit_latched_position_key
            == position_key
        ):
            return _r38tmb1_hold_result(
                now_ns=now_ns,
                position=position,
                reason=(
                    "R38TMB1_EXIT_ALREADY_LATCHED"
                ),
            )

        gate_ok, gate_reason = (
            _r38tmb1_position_gate(
                position
            )
        )

        if not gate_ok:
            return _r38tmb1_hold_result(
                now_ns=now_ns,
                position=position,
                reason=(
                    "R38TMB1_EXIT_GATE_BLOCKED:"
                    + gate_reason
                ),
            )

        try:
            family_surfaces = (
                _r38tmb1_read_family_surfaces(
                    self.redis
                )
            )
        except Exception as exc:
            return _r38tmb1_hold_result(
                now_ns=now_ns,
                position=position,
                reason=(
                    "R38TMB1_FEATURE_SURFACE_BLOCKED"
                ),
                diagnostics={
                    "error":
                        f"{type(exc).__name__}:{exc}",
                },
            )

        quote_resolution = (
            self
            ._r38tmb1_quote_resolver
            .resolve(
                family_surfaces=(
                    family_surfaces
                ),
                position=position,
                now_ns=now_ns,
                local_utc_offset_ns=(
                    _R38TMB1_LOCAL_UTC_OFFSET_NS
                ),
            )
        )

        if (
            not quote_resolution.resolved
            or quote_resolution.quote
            is None
        ):
            return _r38tmb1_hold_result(
                now_ns=now_ns,
                position=position,
                reason=(
                    "R38TMB1_QUOTE_BLOCKED:"
                    + quote_resolution.reason_code
                ),
                diagnostics=(
                    quote_resolution.diagnostics
                ),
            )

        family, _, _, _ = (
            _r38tmb1_position_identity(
                position
            )
        )

        evaluation = (
            self
            ._r38tmb1_exit_manager
            .evaluate(
                now_ns=now_ns,
                family_id=family,
                position=position,
                quote=(
                    quote_resolution.quote
                ),
                signal_changed=False,
            )
        )

        if not evaluation.should_exit:
            return _r38tmb1_hold_result(
                now_ns=now_ns,
                position=position,
                reason=(
                    "R38TMB1_EXIT_NOT_TRIGGERED:"
                    + evaluation.reason_code
                ),
                diagnostics={
                    "quote":
                        quote_resolution.quote,
                    "evaluation":
                        evaluation.to_dict(),
                },
            )

        payload = (
            _r38tmb1_prepare_exit_payload(
                evaluation=evaluation,
                position=position,
                quote=(
                    quote_resolution.quote
                ),
                now_ns=now_ns,
            )
        )

        if not _r38tmb1_exit_decision_allowed(
            payload
        ):
            raise StrategyBridgeError(
                "R38TMB1 prepared EXIT failed exact publication gate"
            )

        self.publish_decision(
            payload
        )

        self._r38tmb1_exit_latched_position_key = (
            position_key
        )

        payload[
            "r38tmb1_exit_latched"
        ] = 1

        return payload

    StrategyService.__init__ = (
        _r38tmb1_init
    )

    StrategyService.run_once = (
        _r38tmb1_run_once
    )

    StrategyService._r38tmb1_exit_integration_installed = True

# END R38TMB1_ACTIVE_STRATEGY_EXIT_GATE_V1
