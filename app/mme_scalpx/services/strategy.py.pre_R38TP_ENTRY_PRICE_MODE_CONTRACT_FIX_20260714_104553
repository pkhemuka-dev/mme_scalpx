        "SCALPX_PAPER_ARMED",
        "SCALPX_ENABLE_PAPER",
        "SCALPX_ENABLE_LIVE",
    )
    return (
        is_truthy("SCALPX_OBSERVE_ONLY")
        and is_truthy("B1_PROFIT_CLASSIC_RUNTIME_OBSERVE_ONLY")
        and not any(is_truthy(name) for name in forbidden)
