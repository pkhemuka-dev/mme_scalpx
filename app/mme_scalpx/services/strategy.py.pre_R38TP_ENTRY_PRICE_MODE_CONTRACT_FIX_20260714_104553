# R38TZD: execution entry-contract enrichment for projected real-live one-event ENTER.
def _r38tzd_extract_strike_from_symbol(symbol: str) -> str:
    import re as _r38tzd_re
    s = _r38ee_upper(symbol)
    m = _r38tzd_re.search(r"(\d+)(CE|PE)$", s)
    if not m:
        return ""
    digits = m.group(1)
    for width in (5, 4):
        if len(digits) >= width:
            candidate = digits[-width:]
            try:
                val = int(candidate)
            except Exception:
                continue
            if 1000 <= val <= 100000:
                return str(val)
    return ""

def _r38tzd_entry_contract_metadata(*, base: Mapping[str, Any], selected: Mapping[str, Any], candidate: Mapping[str, Any], symbol: str, token: str, price: str) -> dict[str, Any]:
    meta = dict(_r38ee_mapping(base.get("metadata")))
    meta.update(_r38ee_mapping(selected.get("metadata")))
    meta.update(_r38ee_mapping(candidate.get("metadata")))

    option_symbol = _r38ee_upper(
        symbol
        or candidate.get("option_symbol")
        or candidate.get("trading_symbol")
        or candidate.get("instrument_key")
        or selected.get("option_symbol")
        or selected.get("trading_symbol")
        or base.get("option_symbol")
        or base.get("symbol")
        or meta.get("option_symbol")
        or meta.get("symbol")
    )
    if ":" in option_symbol:
        option_symbol = option_symbol.split(":", 1)[1]

    option_token = _r38ee_text(
        token
        or candidate.get("option_token")
        or candidate.get("instrument_token")
        or candidate.get("instrument_key")
        or selected.get("option_token")
        or selected.get("instrument_token")
        or base.get("instrument_token")
        or base.get("instrument_key")
        or meta.get("option_token")
        or meta.get("instrument_token")
    )

    strike = _r38ee_text(
        candidate.get("strike")
        or selected.get("strike")
        or base.get("strike")
        or meta.get("strike")
        or _r38tzd_extract_strike_from_symbol(option_symbol)
    )

    limit_price = _r38ee_text(
        price
        or candidate.get("limit_price")
        or candidate.get("price")
        or selected.get("limit_price")
        or selected.get("price")
        or base.get("limit_price")
        or base.get("price")
        or meta.get("limit_price")
        or meta.get("price")
    )

    meta["option_symbol"] = option_symbol
    meta["option_token"] = option_token
    meta["strike"] = strike
    meta["limit_price"] = limit_price
    meta["r38tzd_entry_contract_enriched"] = True
    return meta


# BEGIN R38QA_B1_EXACT_SCOPE_RAW_ENTER_PROMOTION_PATCH
# Controlled-paper-only repair:
# Some B1/Classic decision rows publish action=HOLD but carry raw ENTER evidence.
# Under exact locked env scope + no-broker controlled-paper ACK, promote only the matching row
# into the projected row shape required by the R33I paper publisher.
def _r38qa_b1_exact_scope_raw_enter_promotion(decision: Mapping[str, Any]) -> dict[str, Any]:
    import json as _r38qa_json
    import os as _r38qa_os

    base = dict(decision)

    def _txt(v: object) -> str:
        return str(v or "").strip()

    def _upper(v: object) -> str:
        return _txt(v).upper()

    def _truthy(v: object) -> bool:
        return _upper(v) in {"1", "TRUE", "YES", "Y", "ON", "ALLOW", "ALLOWED"}

    # Hard fail-closed: no live/broker.
    if _truthy(_r38qa_os.environ.get("SCALPX_ENABLE_LIVE")) or _truthy(_r38qa_os.environ.get("MME_ENABLE_LIVE")):
        return base
    if _truthy(_r38qa_os.environ.get("SCALPX_ALLOW_BROKER_ORDERS")) or _truthy(_r38qa_os.environ.get("MME_ALLOW_BROKER_ORDERS")):
        return base

    # Controlled-paper runtime must be explicitly armed.
    if not _truthy(_r38qa_os.environ.get("SCALPX_ALLOW_CONTROLLED_PAPER_RUNTIME")):
        return base
    if not _truthy(_r38qa_os.environ.get("SCALPX_ENABLE_PAPER")):
        return base
    if not _truthy(_r38qa_os.environ.get("SCALPX_PAPER_ARMED")):
        return base

    env_family = _upper(_r38qa_os.environ.get("SCALPX_CONTROLLED_PAPER_FAMILY"))
    env_side = _upper(_r38qa_os.environ.get("SCALPX_CONTROLLED_PAPER_SIDE") or _r38qa_os.environ.get("SCALPX_CONTROLLED_PAPER_BRANCH"))
    env_action = _upper(_r38qa_os.environ.get("SCALPX_CONTROLLED_PAPER_ACTION"))
    env_token = _txt(_r38qa_os.environ.get("SCALPX_CONTROLLED_PAPER_INSTRUMENT_TOKEN"))
    env_symbol = _upper(_r38qa_os.environ.get("SCALPX_CONTROLLED_PAPER_OPTION_SYMBOL"))
    env_ack = _upper(_r38qa_os.environ.get("SCALPX_CONTROLLED_PAPER_SCOPE_ACK"))
    env_no_broker_ack = _upper(_r38qa_os.environ.get("SCALPX_CONTROLLED_PAPER_NO_BROKER_ACK"))

    if ":" in env_symbol:
        env_symbol = env_symbol.split(":", 1)[1]

    # BEGIN R38QH_DYNAMIC_FIRST_ENTER_PATCH
    # Dynamic no-broker controlled-paper mode:
    # Instead of locking token/symbol before restart, promote the first valid live B1 ENTER row
    # after this paper strategy starts. Still fail-closed: paper armed, no broker, no live, 1 lot.
    dynamic_first_enter = _truthy(_r38qa_os.environ.get("SCALPX_CONTROLLED_PAPER_DYNAMIC_FIRST_ENTER"))
    if dynamic_first_enter:
        env_side = "AUTO"
        env_action = "AUTO_ENTER"
        env_token = "AUTO"
        env_symbol = "AUTO"
    else:
        if not all([env_family, env_side, env_action, env_token, env_symbol, env_ack]):
            return base
        if env_side not in {"CALL", "PUT"}:
            return base
        if env_action != "ENTER_" + env_side:
            return base
    if env_ack != "ACK_FOR_CONTROLLED_PROJECTION" and env_ack != env_no_broker_ack:
        return base
    # END R38QH_DYNAMIC_FIRST_ENTER_PATCH

    payload = {}
    for k, v in list(base.items()):
        if isinstance(v, str) and v.strip().startswith("{"):
            try:
                obj = _r38qa_json.loads(v)
                if isinstance(obj, dict):
                    payload.update(obj)
            except Exception:
                pass

    def _pick(*keys: str) -> str:
        for k in keys:
            if _txt(base.get(k)):
                return _txt(base.get(k))
            if _txt(payload.get(k)):
                return _txt(payload.get(k))
        return ""

    raw_action = _upper(_pick(
        "r38fe_decision_action_evidence",
        "activation_selected_action",
        "candidate_action_shadow",
        "r38ee_extracted_action",
        "action",
    ))
    raw_side = _upper(_pick(
        "r38fe_decision_side_evidence",
        "r38ee_extracted_side",
        "side",
        "branch_id",
    ))
    if raw_side == "CE":
        raw_side = "CALL"
    if raw_side == "PE":
        raw_side = "PUT"
    if not raw_side and raw_action == "ENTER_CALL":
        raw_side = "CALL"
    if not raw_side and raw_action == "ENTER_PUT":
        raw_side = "PUT"

    raw_token = _txt(_pick(
        "instrument_token",
        "candidate_instrument_token_shadow",
        "r38ee_extracted_token",
        "option_token",
    ))
    # BEGIN R38QF_CLEAN_R38QA_SYMBOL_PICKER
    # Prefer a real option symbol and ignore placeholder field-name values like
    # R38EE_EXTRACTED_SYMBOL_RAW. This keeps exact-scope promotion locked to
    # the resolved real option symbol while still using genuine live decision rows.
    def _r38qf_clean_symbol(_sym: object) -> str:
        _s = _upper(_sym)
        if ":" in _s:
            _s = _s.split(":", 1)[1]
        _bad = {
            "",
            "NONE",
            "NULL",
            "NAN",
            "SYMBOL",
            "OPTION_SYMBOL",
            "INSTRUMENT_KEY",
            "TRADING_SYMBOL",
            "TRADINGSYMBOL",
            "R38EE_EXTRACTED_SYMBOL",
            "R38EE_EXTRACTED_SYMBOL_RAW",
            "CANDIDATE_SYMBOL_SHADOW",
            "SELECTED_OPTION_SYMBOL",
        }
        if _s in _bad:
            return ""
        if ("CE" not in _s) and ("PE" not in _s):
            return ""
        return _s

    raw_symbol = ""
    for _sym_key in (
        "option_symbol",
        "tradingsymbol",
        "trading_symbol",
        "selected_option_symbol",
        "candidate_symbol_shadow",
        "symbol",
        "r38ee_extracted_symbol",
        "r38ee_extracted_symbol_raw",
        "instrument_key",
    ):
        raw_symbol = _r38qf_clean_symbol(_pick(_sym_key))
        if raw_symbol:
            break
    # END R38QF_CLEAN_R38QA_SYMBOL_PICKER

    # BEGIN R38QH_DYNAMIC_FIRST_ENTER_ROW_BIND
    if dynamic_first_enter:
        if raw_action not in {"ENTER_CALL", "ENTER_PUT"}:
            return base
        if raw_side not in {"CALL", "PUT"}:
            raw_side = "CALL" if raw_action == "ENTER_CALL" else "PUT"
        if raw_action != "ENTER_" + raw_side:
            return base
        if not raw_token or not raw_symbol:
            return base
        env_side = raw_side
        env_action = raw_action
        env_token = raw_token
        env_symbol = raw_symbol
    elif not (
        raw_side == env_side
        and raw_action == env_action
        and raw_token == env_token
        and raw_symbol == env_symbol
    ):
        return base
    # END R38QH_DYNAMIC_FIRST_ENTER_ROW_BIND

    out = dict(base)
    out.update({
        "action": env_action,
        "side": env_side,
        "branch_id": env_side,
        "strategy_family_id": env_family,
        "family_id": env_family,
        "doctrine_id": env_family,
        "instrument_key": env_token,
        "instrument_token": env_token,
        "option_token": env_token,
        "option_symbol": env_symbol,
        "symbol": env_symbol,
        "strike": _r38rf_infer_strike_from_option_symbol(env_symbol),  # R38RJ_PROJECTED_ENTER_STRIKE_PAYLOAD_CONTRACT: top-level projected ENTER strike
        "r38nl_projected_strike": _r38rf_infer_strike_from_option_symbol(env_symbol),  # R38RJ_PROJECTED_ENTER_STRIKE_PAYLOAD_CONTRACT: R33I projected strike
        "qty": 1,
        "quantity_lots": 1,
        "lots": 1,
        "order_type": "LIMIT",
        "hold_only": 0,
        "activation_report_only": 0,
        "activation_action": env_action,
        "activation_promoted": 1,
        "activation_safe_to_promote": 1,
        "safe_to_promote": 1,
        "controlled_paper_promotable": 1,
        "live_orders_allowed": 0,
        "broker_live_order_allowed": 0,
        "real_live_allowed": 0,
        "real_order_sent_shadow": 0,
        "broker_calls_executed_shadow": 0,
        "redis_trading_stream_write_attempted_shadow": 0,
