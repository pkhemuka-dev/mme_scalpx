#!/usr/bin/env bash
# R38EQ hard gate learned from R10H/R10G/R10F.
# Read-only except normal shell proof/report writes by caller.
# No runtime start, no paper arm, no order, no Redis delete.

set +e

MODE="${1:-live-before-runner}"

cd /home/Lenovo/scalpx/projects/mme_scalpx || exit 1

xlen_safe(){ redis-cli XLEN "$1" 2>/dev/null | awk '{print $1+0}'; }
hget_safe(){ redis-cli HGET "$1" "$2" 2>/dev/null | tr -d '\r'; }
rtype_safe(){ redis-cli TYPE "$1" 2>/dev/null | awk '{print $1}' | tr -d '\r'; }
hlen_safe(){ redis-cli HLEN "$1" 2>/dev/null | awk '{print $1+0}'; }

ORDERS="$(xlen_safe orders:mme:stream)"
RISK_STREAM="$(xlen_safe risk:mme:stream)"
EXEC_STREAM="$(xlen_safe execution:mme:stream)"
TRADES="$(xlen_safe trades:ledger:stream)"
CMD="$(xlen_safe cmd:mme:stream)"

FEEDS_PROC="$(ps -eo args | grep -Ei 'python.*app\.mme_scalpx\.main.*--service[ =]feeds' | grep -v grep | wc -l | tr -d ' ')"
FEATURES_PROC="$(ps -eo args | grep -Ei 'python.*app\.mme_scalpx\.main.*--service[ =]features' | grep -v grep | wc -l | tr -d ' ')"
STRATEGY_PROC="$(ps -eo args | grep -Ei 'python.*app\.mme_scalpx\.main.*--service[ =]strategy' | grep -v grep | wc -l | tr -d ' ')"
RISK_PROC="$(ps -eo args | grep -Ei 'python.*app\.mme_scalpx\.main.*--service[ =]risk' | grep -v grep | wc -l | tr -d ' ')"
EXEC_PROC="$(ps -eo args | grep -Ei 'python.*app\.mme_scalpx\.main.*--service[ =]execution' | grep -v grep | wc -l | tr -d ' ')"

REDIS_POLICY="$(redis-cli CONFIG GET maxmemory-policy 2>/dev/null | tail -1 | tr -d '\r')"
REDIS_MAXMEMORY="$(redis-cli CONFIG GET maxmemory 2>/dev/null | tail -1 | tr -d '\r')"
REDIS_AOF="$(redis-cli CONFIG GET appendonly 2>/dev/null | tail -1 | tr -d '\r')"

POS_TYPE="$(rtype_safe state:position:mme)"
POS_SIDE="$(hget_safe state:position:mme position_side)"
POS_QTY_LOTS="$(hget_safe state:position:mme qty_lots)"
POS_QTY_UNITS="$(hget_safe state:position:mme qty_units)"
POS_HAS_POSITION="$(hget_safe state:position:mme has_position)"
POS_REAL_CLEAR="$(hget_safe state:position:mme real_order_clear)"
POS_ORDERS_ZERO="$(hget_safe state:position:mme orders_zero)"
POS_RUNTIME_ZERO="$(hget_safe state:position:mme runtime_zero)"
POS_CMD_ZERO="$(hget_safe state:position:mme cmd_zero)"

BROKER_TYPE="$(rtype_safe state:broker:mme)"
ORDERS_TYPE="$(rtype_safe state:orders:mme)"
BROKER_HLEN="$(hlen_safe state:broker:mme)"
ORDERS_HLEN="$(hlen_safe state:orders:mme)"

LOCK_RISK="$(redis-cli GET lock:risk 2>/dev/null | tr -d '\r')"
LOCK_EXEC="$(redis-cli GET lock:execution 2>/dev/null | tr -d '\r')"

REAL_ORDER_KEYS="$(redis-cli --raw SCAN 0 MATCH '*real*order*' COUNT 200 2>/dev/null | tail -n +2 | head -20 | tr '\n' ' ' | cut -c1-500)"

MARKER_R38EM=0
grep -q "R38EM_R1_PROJECTION_DIAG_AND_SYMBOL_FALLBACK_PATCH" app/mme_scalpx/services/strategy.py && MARKER_R38EM=1

RUNNER_SYNTAX=99
test -s bin/r38en_tomorrow_parallel_scope_controlled_paper_runner.sh && bash -n bin/r38en_tomorrow_parallel_scope_controlled_paper_runner.sh
RUNNER_SYNTAX="$?"

PREFLIGHT_SYNTAX=99
test -s bin/r38eo_tomorrow_preflight_no_start.sh && bash -n bin/r38eo_tomorrow_preflight_no_start.sh
PREFLIGHT_SYNTAX="$?"

FORBIDDEN_RUNNER="$(grep -nE 'redis-cli[^\n]*(DEL|FLUSHDB|FLUSHALL|XDEL|XTRIM)|\bpauto\b|SCALPX_ENABLE_LIVE=1|MME_ENABLE_LIVE=1|SCALPX_ALLOW_BROKER_ORDERS=1|MME_ALLOW_BROKER_ORDERS=1' bin/r38en_tomorrow_parallel_scope_controlled_paper_runner.sh 2>/dev/null || true)"

FAILS=()

[ "$ORDERS/$RISK_STREAM/$EXEC_STREAM/$TRADES/$CMD" = "0/0/0/0/0" ] || FAILS+=("streams_not_zero:$ORDERS/$RISK_STREAM/$EXEC_STREAM/$TRADES/$CMD")
[ "$RISK_PROC/$EXEC_PROC" = "0/0" ] || FAILS+=("risk_or_execution_process_running:$RISK_PROC/$EXEC_PROC")
[ "$REDIS_POLICY" = "noeviction" ] || FAILS+=("redis_policy_not_noeviction:$REDIS_POLICY")
[ "$POS_TYPE" = "hash" ] || FAILS+=("position_hash_missing_or_wrong_type:$POS_TYPE")
[ "$POS_SIDE" = "FLAT" ] || FAILS+=("position_side_not_FLAT:$POS_SIDE")
[ "${POS_QTY_LOTS:-999}" = "0" ] || FAILS+=("qty_lots_not_zero:$POS_QTY_LOTS")
[ "${POS_QTY_UNITS:-999}" = "0" ] || FAILS+=("qty_units_not_zero:$POS_QTY_UNITS")
[ "${POS_HAS_POSITION:-999}" = "0" ] || FAILS+=("has_position_not_zero:$POS_HAS_POSITION")
[ "${POS_REAL_CLEAR:-0}" = "1" ] || FAILS+=("real_order_clear_not_1:$POS_REAL_CLEAR")
[ "${POS_ORDERS_ZERO:-0}" = "1" ] || FAILS+=("orders_zero_not_1:$POS_ORDERS_ZERO")
[ "${POS_RUNTIME_ZERO:-0}" = "1" ] || FAILS+=("runtime_zero_not_1:$POS_RUNTIME_ZERO")
[ "${POS_CMD_ZERO:-0}" = "1" ] || FAILS+=("cmd_zero_not_1:$POS_CMD_ZERO")
[ "$BROKER_HLEN" = "0" ] || FAILS+=("broker_hash_not_empty:$BROKER_HLEN")
[ "$ORDERS_HLEN" = "0" ] || FAILS+=("orders_hash_not_empty:$ORDERS_HLEN")
[ -z "$LOCK_RISK" ] || FAILS+=("lock_risk_present:$LOCK_RISK")
[ -z "$LOCK_EXEC" ] || FAILS+=("lock_execution_present:$LOCK_EXEC")
[ "$MARKER_R38EM" = "1" ] || FAILS+=("r38em_marker_missing")
[ "$RUNNER_SYNTAX" = "0" ] || FAILS+=("runner_syntax_bad:$RUNNER_SYNTAX")
[ "$PREFLIGHT_SYNTAX" = "0" ] || FAILS+=("preflight_syntax_bad:$PREFLIGHT_SYNTAX")
[ -z "$FORBIDDEN_RUNNER" ] || FAILS+=("forbidden_runner_pattern_present")

if [ "$MODE" = "live-before-runner" ]; then
  [ "$FEEDS_PROC" -ge 1 ] || FAILS+=("feeds_not_running:$FEEDS_PROC")
  [ "$FEATURES_PROC" -ge 1 ] || FAILS+=("features_not_running:$FEATURES_PROC")
  [ "$STRATEGY_PROC" -ge 1 ] || FAILS+=("observe_strategy_not_running:$STRATEGY_PROC")
fi

echo "R38EQ_HARD_GATE_MODE=$MODE"
echo "streams=$ORDERS/$RISK_STREAM/$EXEC_STREAM/$TRADES/$CMD"
echo "processes feeds=$FEEDS_PROC features=$FEATURES_PROC strategy=$STRATEGY_PROC risk=$RISK_PROC execution=$EXEC_PROC"
echo "redis maxmemory=$REDIS_MAXMEMORY policy=$REDIS_POLICY appendonly=$REDIS_AOF"
echo "position type=$POS_TYPE side=$POS_SIDE qty_lots=$POS_QTY_LOTS qty_units=$POS_QTY_UNITS has_position=$POS_HAS_POSITION real_order_clear=$POS_REAL_CLEAR orders_zero=$POS_ORDERS_ZERO runtime_zero=$POS_RUNTIME_ZERO cmd_zero=$POS_CMD_ZERO"
echo "state broker_type=$BROKER_TYPE broker_hlen=$BROKER_HLEN orders_type=$ORDERS_TYPE orders_hlen=$ORDERS_HLEN"
echo "locks risk='${LOCK_RISK}' execution='${LOCK_EXEC}'"
echo "marker_r38em=$MARKER_R38EM runner_syntax=$RUNNER_SYNTAX preflight_syntax=$PREFLIGHT_SYNTAX"
echo "real_order_keys_head=${REAL_ORDER_KEYS:-none}"
echo "forbidden_runner_matches=${FORBIDDEN_RUNNER:-none}"

if [ "${#FAILS[@]}" -eq 0 ]; then
  echo "PASS_R38EQ_HARD_GATE"
  exit 0
else
  echo "FAIL_R38EQ_HARD_GATE"
  printf ' - %s\n' "${FAILS[@]}"
  exit 2
fi
