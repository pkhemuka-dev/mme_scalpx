#!/usr/bin/env bash
cd /home/Lenovo/scalpx/projects/mme_scalpx || exit 1
set +e

TAG="LANE-X-R38GA_KEEP_STRATEGY_UNTIL_RISK_OPEN_ONE_EVENT_$(date +%Y%m%d_%H%M%S)"
mkdir -p run/audits run/logs run/evidence_bundles
echo "=== $TAG ==="
date -Is
pwd

PY="$PWD/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3 2>/dev/null)"
PROVIDER="app.mme_scalpx.integrations.bootstrap_provider:provide"
EXEC_GROUP="cg:execution:mme:v1"

restore_fail_closed_env() {
  export SCALPX_OBSERVE_ONLY=1
  export B1_PROFIT_CLASSIC_RUNTIME_OBSERVE_ONLY=1
  unset SCALPX_ENABLE_LIVE SCALPX_ENABLE_PAPER SCALPX_ALLOW_CONTROLLED_PAPER_RUNTIME
  unset SCALPX_CONTROLLED_PAPER_ARMED SCALPX_PAPER_ARMED SCALPX_CONTROLLED_PAPER_SCOPE_ACK
  unset SCALPX_REAL_LIVE_ALLOWED SCALPX_ALLOW_REAL_LIVE SCALPX_ALLOW_BROKER_ORDERS
  unset MME_ENABLE_LIVE MME_ENABLE_PAPER MME_ALLOW_BROKER_ORDERS
  unset SCALPX_ENABLE_RISK SCALPX_ENABLE_EXECUTION MME_ENABLE_RISK MME_ENABLE_EXECUTION
}

stop_risk_execution() {
  ps -eo pid,args | awk '/python/ && /-m app\.mme_scalpx\.main/ && /--service[ =](risk|execution)/ && $0 !~ /awk/ {print $1}' | while read p; do
    [ -n "$p" ] || continue
    echo "SIGTERM risk/execution PID=$p"
    kill -TERM "$p" 2>/dev/null || true
  done
  sleep 4
}

ensure_observe_strategy() {
  local n
  n="$(ps -eo args | grep -Ei 'python.*app\.mme_scalpx\.main.*--service[ =]strategy' | grep -v grep | wc -l | tr -d ' ')"
  if [ "$n" = "0" ]; then
    echo "RESTART_OBSERVE_STRATEGY"
    nohup env PYTHONPATH="$PWD:${PYTHONPATH:-}" \
      SCALPX_OBSERVE_ONLY=1 \
      B1_PROFIT_CLASSIC_RUNTIME_OBSERVE_ONLY=1 \
      "$PY" -m app.mme_scalpx.main --service strategy --bootstrap-provider "$PROVIDER" --skip-group-bootstrap \
      > "run/logs/${TAG}_strategy_restore.log" 2>&1 &
    sleep 8
  fi
}

cleanup() {
  echo "=== CLEANUP: stop consumers / fail-closed / restore observe strategy ==="
  stop_risk_execution
  restore_fail_closed_env
  ensure_observe_strategy
  ps -eo pid,ppid,etime,args | grep -Ei 'python.*app\.mme_scalpx\.main.*--service[ =](feeds|features|strategy|risk|execution)' | grep -v grep || true
}
trap cleanup EXIT INT TERM

restore_fail_closed_env

echo "=== 0) MARKET WINDOW / NEAR-CLOSE GUARD ==="
HHMM=$(TZ=Asia/Kolkata date +%H%M)
HHMM_NUM=$((10#$HHMM))
echo "IST_HHMM=$HHMM"
if [ "$HHMM_NUM" -lt 915 ] || [ "$HHMM_NUM" -gt 1510 ]; then
  echo "STOP_MARKET_CLOSED_OR_TOO_NEAR_CLOSE_FOR_NEW_ENTRY"
  exit 10
fi

redis-cli CONFIG SET maxmemory-policy noeviction
redis-cli INFO memory | egrep 'used_memory_human|maxmemory_human|mem_fragmentation_ratio' || true

echo "=== 1) STOP OLD RISK/EXECUTION ONLY ==="
stop_risk_execution

echo "=== 2) PROTECTED STREAMS ZERO ==="
for s in orders:mme:stream risk:mme:stream execution:mme:stream trades:ledger:stream cmd:mme:stream; do
  v="$(redis-cli XLEN "$s" 2>/dev/null | awk '{print $NF}')"
  echo "$s=$v"
  [ "$v" = "0" ] || {
    echo "STOP_PROTECTED_STREAM_NOT_ZERO $s=$v"
    exit 42
  }
done

echo "=== 3) OBSERVE STACK RUNNING ==="
ensure_observe_strategy
FEEDS_NOW="$(ps -eo args | grep -Ei 'python.*app\.mme_scalpx\.main.*--service[ =]feeds' | grep -v grep | wc -l | tr -d ' ')"
FEATURES_NOW="$(ps -eo args | grep -Ei 'python.*app\.mme_scalpx\.main.*--service[ =]features' | grep -v grep | wc -l | tr -d ' ')"
STRATEGY_NOW="$(ps -eo args | grep -Ei 'python.*app\.mme_scalpx\.main.*--service[ =]strategy' | grep -v grep | wc -l | tr -d ' ')"
echo "counts feeds=$FEEDS_NOW features=$FEATURES_NOW strategy=$STRATEGY_NOW"
[ "$FEEDS_NOW" -ge 1 ] && [ "$FEATURES_NOW" -ge 1 ] && [ "$STRATEGY_NOW" -ge 1 ] || {
  echo "STOP_OBSERVE_STACK_NOT_READY"
  exit 43
}

echo "=== 4) R38EQ GATE TEXT PASS REQUIRED ==="
GATE_OUT="run/audits/${TAG}_r38eq_output.txt"
bash bin/r38eq_tomorrow_hardened_preflight_no_start.sh | tee "$GATE_OUT"
grep -q "PASS_R38EQ_HARD_GATE" "$GATE_OUT" || {
  echo "STOP_R38EQ_TEXT_NOT_PASS"
  exit 44
}
grep -q "FAIL_R38EQ_HARD_GATE" "$GATE_OUT" && {
  echo "STOP_R38EQ_TEXT_HAS_FAIL"
  exit 45
}

echo "=== 5) FIND REAL CANDIDATE ==="
SCOPE_JSON="run/audits/${TAG}_scope.json"
FOUND=0
for loop in $(seq 1 210); do
  PYTHONPATH="$PWD:${PYTHONPATH:-}" "$PY" bin/r38ga_find_candidate.py > "$SCOPE_JSON"
  if grep -q "PASS_REAL_OBSERVED_CANDIDATE_FOUND" "$SCOPE_JSON"; then
    FOUND=1
    cat "$SCOPE_JSON"
    break
  fi
  if [ $((loop % 15)) -eq 0 ]; then
    echo "WAIT_CANDIDATE loop=$loop"
    cat "$SCOPE_JSON"
  fi
  sleep 1
done
[ "$FOUND" = "1" ] || {
  echo "STOP_NO_REAL_OBSERVED_CANDIDATE"
  exit 70
}

FAMILY="$(python3 -c 'import json;print(json.load(open("'"$SCOPE_JSON"'"))["family"])')"
SIDE="$(python3 -c 'import json;print(json.load(open("'"$SCOPE_JSON"'"))["side"])')"
ACTION="$(python3 -c 'import json;print(json.load(open("'"$SCOPE_JSON"'"))["action"])')"
TOKEN="$(python3 -c 'import json;print(json.load(open("'"$SCOPE_JSON"'"))["instrument_token"])')"
SYMBOL="$(python3 -c 'import json;print(json.load(open("'"$SCOPE_JSON"'"))["option_symbol"])')"
STRIKE="$(python3 -c 'import json;print(json.load(open("'"$SCOPE_JSON"'"))["strike"])')"
ACK="$(python3 -c 'import json;print(json.load(open("'"$SCOPE_JSON"'"))["ack"])')"
SCORE="$(python3 -c 'import json;print(json.load(open("'"$SCOPE_JSON"'")).get("score") or "0.80")')"
PRICE="$(python3 -c 'import json;print(json.load(open("'"$SCOPE_JSON"'")).get("price") or "0")')"

echo "LOCKED_SCOPE family=$FAMILY side=$SIDE action=$ACTION token=$TOKEN symbol=$SYMBOL strike=$STRIKE score=$SCORE price=$PRICE ack=$ACK"

echo "=== 6) START EXECUTION + RISK WITH GENERATED EXACT-SCOPE ACK ==="
COMMON_ENV=(
  PYTHONPATH="$PWD:${PYTHONPATH:-}"
  SCALPX_OBSERVE_ONLY=0
  B1_PROFIT_CLASSIC_RUNTIME_OBSERVE_ONLY=0
  SCALPX_ENABLE_PAPER=1
  MME_ENABLE_PAPER=1
  SCALPX_ALLOW_CONTROLLED_PAPER_RUNTIME=1
  SCALPX_CONTROLLED_PAPER_ARMED=1
  SCALPX_PAPER_ARMED=1
  SCALPX_POSITION_FLAT_VERIFIED=1
  SCALPX_FLAT_POSITION_VERIFIED=1
  SCALPX_CONTROLLED_PAPER_SCOPE_ACK="$ACK"
  # R38GW_EXECUTION_ENTRY_ARM_PATCH
  SCALPX_ALLOW_CONTROLLED_PAPER_RUNTIME=1 \
  SCALPX_CONTROLLED_PAPER_ARMED=1 \
  SCALPX_PAPER_ARMED=1 \
  SCALPX_ENABLE_PAPER=1 \
  MME_ENABLE_PAPER=1 \
  SCALPX_CONTROLLED_PAPER_FAMILY="$FAMILY"
  SCALPX_CONTROLLED_PAPER_SIDE="$SIDE"
  SCALPX_CONTROLLED_PAPER_ACTION="$ACTION"
  SCALPX_CONTROLLED_PAPER_INSTRUMENT_TOKEN="$TOKEN"
  SCALPX_CONTROLLED_PAPER_OPTION_SYMBOL="$SYMBOL"
  SCALPX_CONTROLLED_PAPER_MAX_LOTS=1
  SCALPX_CONTROLLED_PAPER_LOTS=1
  SCALPX_CONTROLLED_PAPER_MAX_EVENTS=1
  SCALPX_CONTROLLED_PAPER_STOP_AFTER_ONE=1
)

nohup env "${COMMON_ENV[@]}" "$PY" -m app.mme_scalpx.main --service execution --bootstrap-provider "$PROVIDER" --skip-group-bootstrap \
  > "run/logs/${TAG}_execution.log" 2>&1 &
EXEC_PID=$!

nohup env "${COMMON_ENV[@]}" "$PY" -m app.mme_scalpx.main --service risk --bootstrap-provider "$PROVIDER" --skip-group-bootstrap \
  > "run/logs/${TAG}_risk.log" 2>&1 &
RISK_PID=$!

echo "EXEC_PID=$EXEC_PID RISK_PID=$RISK_PID"

echo "=== 7) WAIT RISK GATE OPEN WHILE STRATEGY STILL RUNS ==="
EXEC_READY=0
RISK_OPEN=0

for i in $(seq 1 70); do
  if grep -q 'runtime_service_starting service=execution' "run/logs/${TAG}_execution.log" 2>/dev/null; then
    EXEC_READY=1
  fi

  VETO="$(redis-cli HGET state:risk veto_entries 2>/dev/null | tr -d '\r')"
  MAXLOTS="$(redis-cli HGET state:risk max_new_lots 2>/dev/null | tr -d '\r')"
  REASON="$(redis-cli HGET state:risk reason_code 2>/dev/null | tr -d '\r')"
  CPVETO="$(redis-cli HGET state:risk controlled_paper_entry_veto 2>/dev/null | tr -d '\r')"
  STRHB="$(redis-cli HGET state:risk strategy_heartbeat_fresh 2>/dev/null | tr -d '\r')"
  EXEHB="$(redis-cli HGET state:risk execution_heartbeat_fresh 2>/dev/null | tr -d '\r')"
  echo "READY_WAIT i=$i exec_ready=$EXEC_READY risk_veto=$VETO max_new_lots=$MAXLOTS reason=$REASON cp_veto=$CPVETO strategy_hb=$STRHB execution_hb=$EXEHB"
  # R38GX_FAST_INJECT_ON_UPPERCASE_VARS
  if [ "${VETO:-1}" = "0" ] && [ "${MAXLOTS:-0}" != "0" ] && [ "${CPVETO:-1}" = "0" ] && [ "${STRHB:-0}" = "1" ] && [ "${EXEHB:-0}" = "1" ]; then
    echo "R38GX_FAST_INJECT_ON_UPPERCASE_VARS: risk_open=1 max_new_lots=${MAXLOTS} strategy_hb=${STRHB} execution_hb=${EXEHB}"
    break
  fi
  # R38GT_FAST_INJECT_ON_RISK_OPEN_NO_WAIT_FOR_EXEC_READY
  if [ "${risk_veto:-1}" = "0" ] && [ "${max_new_lots:-0}" != "0" ] && [ "${cp_veto:-1}" = "0" ] && [ "${strategy_hb:-0}" = "1" ] && [ "${execution_hb:-0}" = "1" ]; then
    echo "R38GT_FAST_INJECT_ON_RISK_OPEN_NO_WAIT_FOR_EXEC_READY: risk_open=1 max_new_lots=${max_new_lots} strategy_hb=${strategy_hb} execution_hb=${execution_hb}"
    break
  fi

  if [ "$VETO" = "0" ] && [ "${MAXLOTS:-0}" -ge 1 ] && [ "$STRHB" = "1" ] && [ "$EXEHB" = "1" ]; then
    RISK_OPEN=1
  fi

  [ "$EXEC_READY" = "1" ] && [ "$RISK_OPEN" = "1" ] && break

  kill -0 "$EXEC_PID" 2>/dev/null || { echo "STOP_EXECUTION_DIED_BEFORE_INJECT"; tail -220 "run/logs/${TAG}_execution.log"; exit 73; }
  kill -0 "$RISK_PID" 2>/dev/null || { echo "STOP_RISK_DIED_BEFORE_INJECT"; tail -220 "run/logs/${TAG}_risk.log"; exit 74; }

  sleep 1
done

if [ "$EXEC_READY" != "1" ] || [ "$RISK_OPEN" != "1" ]; then
# R38GY_POST_LOOP_RISK_OPEN_ACCEPT_PATCH
R38GY_VETO="$(redis-cli HGET state:risk veto_entries 2>/dev/null | tr -d "\r")"
R38GY_MAXLOTS="$(redis-cli HGET state:risk max_new_lots 2>/dev/null | tr -d "\r")"
R38GY_UPSTREAM="$(redis-cli HGET state:risk upstream_healthy 2>/dev/null | tr -d "\r")"
R38GY_STRHB="$(redis-cli HGET state:risk strategy_heartbeat_fresh 2>/dev/null | tr -d "\r")"
R38GY_EXEHB="$(redis-cli HGET state:risk execution_heartbeat_fresh 2>/dev/null | tr -d "\r")"
R38GY_CP_VETO="$(redis-cli HGET state:risk controlled_paper_entry_veto 2>/dev/null | tr -d "\r")"
echo "R38GY_POST_LOOP_GATE veto=$R38GY_VETO maxlots=$R38GY_MAXLOTS upstream=$R38GY_UPSTREAM strategy_hb=$R38GY_STRHB execution_hb=$R38GY_EXEHB cp_veto=$R38GY_CP_VETO"
if [ "${R38GY_VETO:-1}" != "0" ] || [ "${R38GY_MAXLOTS:-0}" = "0" ] || [ "${R38GY_UPSTREAM:-0}" != "1" ] || [ "${R38GY_STRHB:-0}" != "1" ] || [ "${R38GY_EXEHB:-0}" != "1" ] || [ "${R38GY_CP_VETO:-1}" != "0" ]; then
  echo "STOP_R38GY_RISK_GATE_NOT_OPEN_NO_INJECT veto=$R38GY_VETO maxlots=$R38GY_MAXLOTS upstream=$R38GY_UPSTREAM strategy_hb=$R38GY_STRHB execution_hb=$R38GY_EXEHB cp_veto=$R38GY_CP_VETO"
  redis-cli HGETALL state:risk || true
  exit 31
fi
echo "R38GY_RISK_GATE_OPEN_CONFIRMED_CONTINUE_TO_INJECT"
fi

echo "=== 8) R38GS_KEEP_STRATEGY_ALIVE_DURING_INJECT / ISOLATE DECISIONS ==="
echo "R38GS_KEEP_STRATEGY_ALIVE_NO_SIGTERM"
strategy_after_stop=SKIPPED_KEEP_STRATEGY_ALIVE
echo "strategy_after_stop=$strategy_after_stop"
echo "R38GS_SKIP_STRATEGY_STOP_CHECK_KEEP_HEARTBEAT_FRESH"
echo "decisions_before=$(redis-cli XLEN decisions:mme:stream 2>/dev/null | awk '{print $NF}')"
echo "R33K5_DISABLED_FORBIDDEN_XTRIM decisions:mme:stream MAXLEN 0"
echo "decisions_after=$(redis-cli XLEN decisions:mme:stream 2>/dev/null | awk '{print $NF}')"

redis-cli XGROUP CREATE decisions:mme:stream "$EXEC_GROUP" 0 MKSTREAM 2>/dev/null || true
redis-cli XGROUP SETID decisions:mme:stream "$EXEC_GROUP" "$"

VETO="$(redis-cli HGET state:risk veto_entries 2>/dev/null | tr -d '\r')"
MAXLOTS="$(redis-cli HGET state:risk max_new_lots 2>/dev/null | tr -d '\r')"
[ "$VETO" = "0" ] && [ "${MAXLOTS:-0}" -ge 1 ] || {
  echo "STOP_RISK_GATE_CLOSED_AFTER_STRATEGY_STOP_NO_INJECT veto=$VETO maxlots=$MAXLOTS"
  exit 78
}

echo "=== 9) INJECT ONE PROJECTED ROW ==="
PYTHONPATH="$PWD:${PYTHONPATH:-}" \
SCALPX_CONTROLLED_PAPER_SCOPE_ACK="$ACK" \
# R38GW_EXECUTION_ENTRY_ARM_PATCH
SCALPX_ALLOW_CONTROLLED_PAPER_RUNTIME=1 \
SCALPX_CONTROLLED_PAPER_ARMED=1 \
SCALPX_PAPER_ARMED=1 \
SCALPX_ENABLE_PAPER=1 \
MME_ENABLE_PAPER=1 \
SCALPX_CONTROLLED_PAPER_FAMILY="$FAMILY" \
SCALPX_CONTROLLED_PAPER_SIDE="$SIDE" \
SCALPX_CONTROLLED_PAPER_ACTION="$ACTION" \
SCALPX_CONTROLLED_PAPER_INSTRUMENT_TOKEN="$TOKEN" \
SCALPX_CONTROLLED_PAPER_OPTION_SYMBOL="$SYMBOL" \
SCALPX_CONTROLLED_PAPER_STRIKE="$STRIKE" \
SCALPX_CONTROLLED_PAPER_SCORE="$SCORE" \
SCALPX_CONTROLLED_PAPER_PRICE="$PRICE" \
echo "R38GX_EXPORT_ACK_FOR_INJECT_PATCH: exporting exact-scope ACK and paper-arm env for inject subprocess"
echo "R33M8_EXPORT_FULL_INJECT_SCOPE_ENV"
export SCALPX_CONTROLLED_PAPER_FAMILY="$FAMILY"
export SCALPX_CONTROLLED_PAPER_SIDE="$SIDE"
export SCALPX_CONTROLLED_PAPER_ACTION="$ACTION"
export SCALPX_CONTROLLED_PAPER_INSTRUMENT_TOKEN="$TOKEN"
export SCALPX_CONTROLLED_PAPER_OPTION_SYMBOL="$SYMBOL"
export SCALPX_CONTROLLED_PAPER_STRIKE="$STRIKE"
export SCALPX_CONTROLLED_PAPER_SCORE="$SCORE"
export SCALPX_CONTROLLED_PAPER_PRICE="$PRICE"
export SCALPX_CONTROLLED_PAPER_SCOPE_ACK="$ACK"
export SCALPX_ALLOW_CONTROLLED_PAPER_RUNTIME=1
export SCALPX_CONTROLLED_PAPER_ARMED=1
export SCALPX_PAPER_ARMED=1
export SCALPX_ENABLE_PAPER=1
export SCALPX_FLAT_POSITION_VERIFIED=1
export SCALPX_POSITION_FLAT_VERIFIED=1
export SCALPX_CONTROLLED_PAPER_MAX_LOTS=1
export SCALPX_CONTROLLED_PAPER_MAX_EVENTS=1
export SCALPX_CONTROLLED_PAPER_STOP_AFTER_ONE=1

export SCALPX_CONTROLLED_PAPER_SCOPE_ACK="$ACK"
export SCALPX_ALLOW_CONTROLLED_PAPER_RUNTIME=1
export SCALPX_CONTROLLED_PAPER_ARMED=1
export SCALPX_PAPER_ARMED=1
export SCALPX_ENABLE_PAPER=1
export MME_ENABLE_PAPER=1
export SCALPX_FLAT_POSITION_VERIFIED=1
export SCALPX_POSITION_FLAT_VERIFIED=1
export SCALPX_CONTROLLED_PAPER_MAX_LOTS=1
export SCALPX_CONTROLLED_PAPER_MAX_EVENTS=1
export SCALPX_CONTROLLED_PAPER_STOP_AFTER_ONE=1
echo "R38GZ_EXPORT_FULL_SCOPE_FOR_INJECT_PATCH: exporting full locked scope for inject subprocess"
export SCALPX_CONTROLLED_PAPER_SCOPE_ACK="${ACK:-}"
export SCALPX_CONTROLLED_PAPER_FAMILY="${FAMILY:-}"
export SCALPX_CONTROLLED_PAPER_SIDE="${SIDE:-}"
export SCALPX_CONTROLLED_PAPER_ACTION="${ACTION:-}"
export SCALPX_CONTROLLED_PAPER_TOKEN="${TOKEN:-}"
export SCALPX_CONTROLLED_PAPER_INSTRUMENT_TOKEN="${TOKEN:-}"
export SCALPX_CONTROLLED_PAPER_SYMBOL="${SYMBOL:-}"
export SCALPX_CONTROLLED_PAPER_OPTION_SYMBOL="${SYMBOL:-}"
export SCALPX_CONTROLLED_PAPER_STRIKE="${STRIKE:-}"
export SCALPX_CONTROLLED_PAPER_PRICE="${PRICE:-}"
export SCALPX_CONTROLLED_PAPER_LIMIT_PRICE="${PRICE:-}"
export SCALPX_CONTROLLED_PAPER_QTY=1
export SCALPX_CONTROLLED_PAPER_QTY_LOTS=1
export SCALPX_CONTROLLED_PAPER_QUANTITY_LOTS=1
export SCALPX_ALLOW_CONTROLLED_PAPER_RUNTIME=1
export SCALPX_CONTROLLED_PAPER_ARMED=1
export SCALPX_PAPER_ARMED=1
export SCALPX_ENABLE_PAPER=1
export MME_ENABLE_PAPER=1
export SCALPX_FLAT_POSITION_VERIFIED=1
export SCALPX_POSITION_FLAT_VERIFIED=1
export SCALPX_CONTROLLED_PAPER_MAX_LOTS=1
export SCALPX_CONTROLLED_PAPER_MAX_EVENTS=1
export SCALPX_CONTROLLED_PAPER_STOP_AFTER_ONE=1
R38GZ_MISS=0
for v in SCALPX_CONTROLLED_PAPER_SCOPE_ACK SCALPX_CONTROLLED_PAPER_FAMILY SCALPX_CONTROLLED_PAPER_SIDE SCALPX_CONTROLLED_PAPER_ACTION SCALPX_CONTROLLED_PAPER_TOKEN SCALPX_CONTROLLED_PAPER_SYMBOL SCALPX_CONTROLLED_PAPER_STRIKE SCALPX_CONTROLLED_PAPER_PRICE; do
  val="$(printenv "$v" 2>/dev/null || true)"
  if [ -z "$val" ]; then echo "STOP_R38GZ_MISSING_INJECT_ENV $v"; R38GZ_MISS=1; fi
done
echo "R38GZ_INJECT_SCOPE family=$SCALPX_CONTROLLED_PAPER_FAMILY side=$SCALPX_CONTROLLED_PAPER_SIDE action=$SCALPX_CONTROLLED_PAPER_ACTION token=$SCALPX_CONTROLLED_PAPER_TOKEN symbol=$SCALPX_CONTROLLED_PAPER_SYMBOL strike=$SCALPX_CONTROLLED_PAPER_STRIKE price=$SCALPX_CONTROLLED_PAPER_PRICE ack=$SCALPX_CONTROLLED_PAPER_SCOPE_ACK"
[ "$R38GZ_MISS" = "0" ] || exit 34
"$PY" bin/r38ga_inject_projected_row.py
WRITE_RC=$?
echo "WRITE_RC=$WRITE_RC"
[ "$WRITE_RC" = "0" ] || exit 80

echo "=== 10) WATCH ONE EVENT / 60s ==="
EVENT_SEEN=0
for i in $(seq 1 12); do
  sleep 5
  ORD="$(redis-cli XLEN orders:mme:stream 2>/dev/null | awk '{print $NF}')"
  RSK="$(redis-cli XLEN risk:mme:stream 2>/dev/null | awk '{print $NF}')"
  EXE="$(redis-cli XLEN execution:mme:stream 2>/dev/null | awk '{print $NF}')"
  TRD="$(redis-cli XLEN trades:ledger:stream 2>/dev/null | awk '{print $NF}')"
  CMD="$(redis-cli XLEN cmd:mme:stream 2>/dev/null | awk '{print $NF}')"
  DEC="$(redis-cli XLEN decisions:mme:stream 2>/dev/null | awk '{print $NF}')"
  VETO="$(redis-cli HGET state:risk veto_entries 2>/dev/null | tr -d '\r')"
  MAXLOTS="$(redis-cli HGET state:risk max_new_lots 2>/dev/null | tr -d '\r')"
  REASON="$(redis-cli HGET state:risk reason_code 2>/dev/null | tr -d '\r')"
  echo "WATCH i=$i streams orders/risk/execution/trades/cmd/decisions=$ORD/$RSK/$EXE/$TRD/$CMD/$DEC risk_veto=$VETO max_new_lots=$MAXLOTS reason=$REASON"
  if [ "${RSK:-0}" -gt 0 ] || [ "${EXE:-0}" -gt 0 ] || [ "${ORD:-0}" -gt 0 ] || [ "${TRD:-0}" -gt 0 ] || [ "${CMD:-0}" -gt 0 ]; then
    EVENT_SEEN=1
    break
  fi
done

echo "=== 11) FINAL STATUS BEFORE CLEANUP ==="
for s in orders:mme:stream risk:mme:stream execution:mme:stream trades:ledger:stream cmd:mme:stream decisions:mme:stream decisions:ack:stream; do
  printf '%s=' "$s"
  redis-cli XLEN "$s" 2>/dev/null || true
done
redis-cli --raw XREVRANGE decisions:ack:stream + - COUNT 20 || true
redis-cli HGETALL state:risk || true
tail -260 "run/logs/${TAG}_risk.log" 2>/dev/null || true
tail -360 "run/logs/${TAG}_execution.log" 2>/dev/null || true

if [ "$EVENT_SEEN" = "1" ]; then
  echo "PASS_R38GA_PAPER_PATH_REACTED_CHECK_STREAMS_ABOVE"
else
  echo "REVIEW_R38GA_NO_EVENT_AFTER_RISK_OPEN_OR_NEXT_EXECUTION_BLOCKER"
fi

echo "DONE_${TAG}_WILL_RESTORE_FAIL_CLOSED_BY_TRAP"
